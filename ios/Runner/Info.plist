<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Vaultara</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>vaultara</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Vaultara uses your approximate location only to see which country you are in when you ask about trips. Only the country is used and it is not saved.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>Vaultara uses biometric authentication to protect your documents.</string>
		<key>NSCameraUsageDescription</key>
		<string>Vaultara uses the camera to scan documents and add photos of your records.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Vaultara lets you choose photos of your documents to add to your records.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Vaultara uses the microphone when you speak a question to Ask Vaultara.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>Vaultara turns your spoken question into text for Ask Vaultara.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>https</string>
			<string>message</string>
		</array>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>NSUserNotificationUsageDescription</key>
		<string>Vaultara sends reminders before important items expire.</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- vaultara:// links, and the return address for Continue with Google
		     (the reversed iOS client ID from GoogleService-Info.plist). Universal
		     links are set in Runner.entitlements. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>vaultara</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.14180323356-qbpk1phpiiif834v8b8am8eeb4g923co</string>
				</array>
			</dict>
		</array>
	</dict>
</plist>