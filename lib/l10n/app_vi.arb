  "storySampleGym": "Thẻ tập gym",
  "storySampleFirstAid": "Chứng chỉ sơ cứu",
  "storySampleEncrypt": "Mã hóa ảnh",
  "storySampleAppLock": "Khóa ứng dụng",
  "storySampleHideApp": "Ẩn nội dung trong trình chuyển ứng dụng",
  "storyHome1Title": "Một ngày của bạn trong nháy mắt",
  "storyHome1Body": "Màn hình chính cho thấy điều quan trọng hôm nay: thứ sắp hết hạn và bạn có bao nhiêu mục.",
  "storyHome2Title": "Tìm bất cứ thứ gì",
  "storyHome2Body": "Chạm vào tìm kiếm để tìm mục theo tên, nhóm hoặc người.",
  "storyHome3Title": "Chuyến đi và kế hoạch",
  "storyHome3Body": "Chuyến đi bạn đang lên kế hoạch và các kế hoạch sự kiện cuộc sống đang diễn ra, cùng việc còn lại, hiện ở đây.",
  "storyHome4Title": "Trợ giúp chỉ một chạm",
  "storyHome4Body": "Nút lấp lánh mở «Hỏi Vaultara». Ảnh của bạn mở hồ sơ, cài đặt và hướng dẫn.",
  "storyRenew1Title": "Có lời nhắc",
  "storyRenew1Body": "Trước khi một mục hết hạn, Vaultara nhắc bạn. Chạm vào lời nhắc để mở mục.",
  "storyRenew2Title": "Lưu ngày mới",
  "storyRenew2Body": "Đã gia hạn? Chạm «Gia hạn» và nhập ngày hết hạn mới. Lời nhắc sẽ dời theo.",
  "storyRenew3Title": "Chưa rõ cách làm?",
  "storyRenew3Body": "Nhiều mục có hướng dẫn với các bước, giấy tờ và chi phí thường gặp.",
  "storyRenew4Title": "Để nó lặp lại",
  "storyRenew4Body": "Với gói đăng ký và khoản thanh toán hằng năm, bật lặp lại và ngày sẽ tự dời tới.",
  "storyAsk1Title": "Hỏi bằng lời của bạn",
  "storyAsk1Body": "Hỏi chẳng hạn «Năm nay có gì hết hạn?» và nhận câu trả lời từ chính các mục của bạn.",
  "storyAsk2Title": "Nói thay vì gõ",
  "storyAsk2Body": "Chạm micro và nói. Lời của bạn hiện ra khi nói và bạn có thể gửi ngay.",
  "storyAsk3Title": "Bạn xác nhận mọi thay đổi",
  "storyAsk3Body": "Yêu cầu thêm hoặc sửa một mục và bạn sẽ thấy một thẻ trước. Không gì được lưu cho đến khi bạn xác nhận.",
  "storyAsk4Title": "Hoàn tác mọi thay đổi",
  "storyAsk4Body": "Đổi ý? Mọi thay đổi đã xác nhận đều có thể hoàn tác từ chính thẻ đó.",
  "storyAsk5Title": "Tiếp tục từ chỗ bạn dừng",
  "storyAsk5Body": "Cuộc trò chuyện được lưu 90 ngày trong «Lịch sử trò chuyện» và câu hỏi gợi ý giúp bạn bắt đầu.",
  "storyWallet1Title": "Chuẩn bị trước",
  "storyWallet1Body": "Mở một thẻ hoặc giấy tờ và chọn nơi bạn cất, ví dụ ví hoặc túi.",
  "storyWallet2Title": "Lưu số khóa thẻ",
  "storyWallet2Body": "Thêm số khóa thẻ của từng ngân hàng ngay. Số này in trên thẻ, thứ bạn sẽ không có khi cần.",
  "storyWallet3Title": "Nếu bị mất",
  "storyWallet3Body": "Mở «Tôi bị mất ví» và chạm «Bị mất» hoặc «Bị trộm». Vaultara liệt kê mọi thứ có trong đó.",
  "storyWallet4Title": "Khóa thẻ trong vài phút",
  "storyWallet4Body": "Gọi từng ngân hàng chỉ với một chạm, đánh dấu thẻ đã khóa và lưu số trình báo.",
  "storyWallet5Title": "Làm lại và giữ an toàn",
  "storyWallet5Body": "Làm lại giấy tờ, kiểm tra sao kê khi được nhắc và chạm «Tôi đã tìm thấy» nếu tìm thấy.",
  "storyLife1Title": "Khoảnh khắc lớn, một kế hoạch",
  "storyLife1Body": "Chuyển nhà, sinh con, việc mới hay khẩn cấp: chọn trong «Sự kiện trong đời» điều đang xảy ra.",
  "storyLife2Title": "Các mục của bạn, gọn gàng",
  "storyLife2Body": "Kế hoạch cho thấy mục nào cần cập nhật, hủy hoặc gia hạn và mục nào có thể cần thêm.",
  "storyLife3Title": "Bước và ngày",
  "storyLife3Body": "Các bước bao gồm những việc không phải là mục, và ngày bắt đầu cho biết khi nào nộp đơn để không gì bị trễ.",
  "storyLife4Title": "Biến nó thành của bạn",
  "storyLife4Body": "Thêm bước của riêng bạn, chia sẻ kế hoạch dạng PDF và nhận lời nhắc quanh ngày đó.",
  "storyPhotos1Title": "Ảnh giấy tờ của bạn",
  "storyPhotos1Body": "Từ trong mục, thêm ảnh mặt trước và mặt sau của thẻ hoặc giấy tờ.",
  "storyPhotos2Title": "Mã hóa trên điện thoại",
  "storyPhotos2Body": "Bật mã hóa ảnh và ảnh sẽ được khóa trên điện thoại trước khi tải lên.",
  "storyPhotos3Title": "Khóa mục nhạy cảm",
  "storyPhotos3Body": "Khóa một mục và nó sẽ yêu cầu vân tay hoặc khóa màn hình trước khi mở.",
  "storyPhotos4Title": "Khóa toàn bộ ứng dụng",
  "storyPhotos4Body": "Trong cài đặt bảo mật, bật khóa ứng dụng và ẩn nội dung khi chuyển ứng dụng.",
  "storyShare1Title": "Chia sẻ một mục",
  "storyShare1Body": "Mở một mục và chia sẻ liên kết chỉ hiện mục đó, không gì khác.",
  "storyShare2Title": "Bộ hồ sơ chứng minh",
  "storyShare2Body": "Gộp các mục bạn chọn, kèm ảnh, vào một PDF cho chủ nhà, ngân hàng hoặc cơ quan.",
  "storyShare3Title": "Giữ quyền kiểm soát",
  "storyShare3Body": "«Liên kết đã chia sẻ» hiện mọi liên kết bạn đã tạo. Dừng bất kỳ liên kết nào bất cứ lúc nào và nó sẽ không mở được nữa.",
  "storyHousehold1Title": "Mời hộ gia đình",
  "storyHousehold1Body": "Chia sẻ mã hoặc liên kết mời. Mỗi người đăng nhập bằng tài khoản riêng.",
  "storyHousehold2Title": "Một bộ mục chung",
  "storyHousehold2Body": "Mọi người thấy cùng các mục chung và nhận cùng lời nhắc.",
  "storyHousehold3Title": "Của ai?",
  "storyHousehold3Body": "Mỗi mục có thể thuộc về ai đó. Tên của họ hiện trên mục và trong lời nhắc.",
  "storyImport1Title": "Quét thẻ",
  "storyImport1Body": "Chụp ảnh thẻ hoặc giấy tờ và Vaultara điền tên và ngày hết hạn giúp bạn.",
  "storyImport2Title": "Nhập danh sách",
  "storyImport2Body": "Đã có bảng tính? Nhập vào và kiểm tra từng dòng trước khi lưu.",
  "storyImport3Title": "Chia sẻ vào Vaultara",
  "storyImport3Body": "Chia sẻ ảnh, PDF hoặc văn bản từ ứng dụng khác vào Vaultara để bắt đầu mục mới.",
  "storyCosts1Title": "Trong lịch của bạn",
  "storyCosts1Body": "Thêm ngày hết hạn vào lịch điện thoại, cạnh các kế hoạch khác của bạn.",
  "storyCosts2Title": "Chi phí gia hạn",
  "storyCosts2Body": "Nhập chi phí gia hạn vào mục và Vaultara cho thấy bạn chi bao nhiêu mỗi năm.",
  "storyCosts3Title": "Lên kế hoạch trước",
  "storyCosts3Body": "Thấy trước những tháng tốn kém để một lần gia hạn lớn không bao giờ làm bạn bất ngờ.",
  "storyBusiness1Title": "Theo dõi đội ngũ",
  "storyBusiness1Body": "Thêm nhân viên và giữ chứng chỉ, giấy phép và bằng cấp của họ ở một nơi.",
  "storyBusiness2Title": "Nhắc qua email",
  "storyBusiness2Body": "Nhân viên nhận email trước khi giấy tờ hết hạn, kể cả khi không có ứng dụng.",
  "storyBusiness3Title": "Báo cáo hằng tháng",
  "storyBusiness3Body": "Mỗi tháng một báo cáo cho thấy gì còn hiệu lực, gì sắp hết hạn và gì còn thiếu.",
  "storyBusiness4Title": "Yêu cầu cập nhật",
  "storyBusiness4Body": "Gửi liên kết và nhân viên tự tải lên giấy tờ đã gia hạn.",
