  "travelRuleThreeMonthsSchengen": "Schengen பகுதியை விட்டுச் சென்ற பிறகு 3 மாதங்கள் கடவுச்சீட்டு செல்லுபடியாக இருக்க வேண்டும்",
  "travelRuleWholeTrip": "முழுப் பயணத்துக்கும் கடவுச்சீட்டு செல்லுபடியாக இருக்க வேண்டும்",
  "travelRuleAuto": "தானியங்கி, சேருமிடத்தின் அடிப்படையில்",
  "travelRuleReasonNoDestination": "சேருமிடம் தேர்ந்தெடுக்கப்படவில்லை, எனவே பெரும்பாலான நாடுகள் ஏற்கும் 6 மாதங்களை Vaultara பயன்படுத்துகிறது.",
  "travelRuleReasonFrom": "{places} அடிப்படையில்.",
  "travelRuleReasonChosen": "இந்தப் பயணத்துக்கு இந்த விதியை நீங்கள் தேர்ந்தெடுத்தீர்கள்.",
  "travelRuleEmbassy": "பயணம் செய்வதற்கு முன் தூதரக விதிகளைச் சரிபாருங்கள்.",
  "travelRuleChange": "விதியை மாற்று",
  "travelItemLicence": "ஓட்டுநர் உரிமம் எடுத்து வைக்கப்பட்டது",
  "travelItemRoute": "உங்கள் வழியில் உள்ள ஒவ்வொரு நாட்டுக்கும் நுழைவு விதிகள் சரிபார்க்கப்பட்டன",
  "travelItemGroupCopies": "அனைவரின் கடவுச்சீட்டு நகல்களும் ஒரே பகிர்ந்த இடத்தில்",
  "travelItemLongTrip": "நீங்கள் இல்லாத நேரத்துக்கான கட்டணங்கள், அஞ்சல், செடிகள் ஏற்பாடு செய்யப்பட்டன",
  "tutorialsTravelTitle": "பயணச் சரிபார்ப்பு",
  "tutorialsTravelSubtitle": "பயணத்துக்கு முன் உங்கள் ஆவணங்களைச் சரிபாருங்கள்",
  "tutorialsSmartToolsTitle": "ஸ்மார்ட் கருவிகளைப் பயன்படுத்துதல்",
  "tutorialsSmartToolsSubtitle": "தொலைந்த பணப்பை, வாழ்க்கை நிகழ்வுகள், சான்றுத் தொகுப்புகள், பகிர்ந்த இணைப்புகள்",
  "tutorialsFamilyTitle": "குடும்பமும் நபர்களும்",
  "tutorialsFamilySubtitle": "நபர்களைச் சேர்த்து, பதிவு யாருடையது என்பதைத் தேர்ந்தெடுங்கள்",
  "tutorialsPlansTitle": "திட்டத்தைத் தேர்ந்தெடுத்தல்",
  "tutorialsPlansSubtitle": "திட்டங்களையும் கட்டண விருப்பங்களையும் ஒப்பிடுங்கள்",
  "tutorialsCompletedLabel": "முடிந்தது",
  "tutorialAddRecordMoreDetails": "மேலும் விவரங்கள் பகுதியில் கூடுதல் விருப்பங்கள் உள்ளன: குறிப்புகள், மீண்டும் வருதல், புதுப்பிக்க ஆகும் நேரம், பதிவு யாருடையது, பூட்டு, பணப்பை, புகைப்படங்கள். தேவைப்படும்போது மட்டும் திறங்கள்.",
  "tutorialAddRecordRepeat": "மீண்டும் வருதல் சந்தாக்களுக்குத் தேதியை முன்னால் நகர்த்தும். புதுப்பிக்க ஆகும் நேரம் சுமார் என்பது புதுப்பிக்க எவ்வளவு நேரம் ஆகும் என்பதை Vaultara-வுக்குச் சொல்லும், அதனால் நினைவூட்டல்கள் போதுமான முன்கூட்டியே தொடங்கும்.",
  "tutorialAddRecordProtect": "ஒரு பதிவைப் பூட்டினால், அதைக் காட்டுவதற்கு முன் உங்கள் கைரேகை அல்லது திரைப் பூட்டு கேட்கப்படும். அட்டைகளை என் பணப்பையில் எனக் குறியிட்டு, ஆவணத்தின் புகைப்படங்களைச் சேருங்கள்.",
  "tutorialTravelReadiness": "பயணத் தயார்நிலை Vaultara-வில் சேமித்துள்ள கடவுச்சீட்டுகளையும் ஓட்டுநர் உரிமங்களையும் சரிபார்க்கும், உங்களுக்கும் நீங்கள் கவனித்துக்கொள்பவர்களுக்கும்.",
  "tutorialTravelLocked": "ப்ரீமியம் மூலம் பயணங்களைத் திட்டமிட்டு, புறப்படுவதற்கு முன் ஒவ்வொரு பயணியும் எந்த ஆவணங்களைப் புதுப்பிக்க வேண்டும் என்பதைப் பார்க்கலாம்.",
  "tutorialTravelTripCard": "ஒவ்வொரு பயணமும் நீங்கள் எப்போது புறப்படுகிறீர்கள் என்பதையும், செல்வதற்கு முன் எதைச் சரிசெய்ய வேண்டும் என்பதையும் காட்டும். திறக்க ஒரு பயணத்தைத் தட்டுங்கள்.",
  "tutorialTravelPlanTrip": "எங்கே, எப்போது, யார் செல்கிறார்கள் என்பதைச் சேர்க்க பயணம் திட்டமிடு என்பதைத் தட்டுங்கள்.",
  "tutorialTravelTripDocuments": "ஒரு பயணத்தின் உள்ளே, Vaultara ஒவ்வொரு பயணியின் பதிவுகளையும் பயணத் தேதிகளுடன் சரிபார்த்து, எதைப் புதுப்பிக்க வேண்டும் என்பதைக் காட்டும்.",
  "tutorialTravelTripChecklist": "பயணத்துக்கான சரிபார்ப்புப் பட்டியலை வைத்துக்கொண்டு, தயாராகும்போது உருப்படிகளைக் குறியிடுங்கள்.",
  "tutorialSmartLostWallet": "பணப்பை தொலைந்துவிட்டதா? என் பணப்பையில் எனக் குறியிட்ட எல்லாப் பதிவுகளையும் பாருங்கள், எதை ரத்து செய்து மாற்ற வேண்டும் என்பது தெரியும்.",
  "tutorialSmartLifeEvents": "வீடு மாறுகிறீர்களா, பெயரை மாற்றுகிறீர்களா அல்லது கார் வாங்குகிறீர்களா? வாழ்க்கை நிகழ்வுகள் எந்தப் பதிவுகளைப் புதுப்பிக்க வேண்டும் என்பதைக் காட்டும்.",
  "tutorialSmartProofPack": "சான்றுத் தொகுப்பு நீங்கள் தேர்ந்தெடுத்த பதிவுகளை அவற்றின் புகைப்படங்களுடன் பகிரக்கூடிய ஒரே PDF-இல் சேர்க்கும்.",
  "tutorialSmartSharedLinks": "பகிர்ந்த இணைப்புகள் நீங்கள் பகிர்ந்த ஒவ்வொரு இணைப்பையும் பட்டியலிடும். எப்போது வேண்டுமானாலும் ஓர் இணைப்பை நிறுத்தலாம், அதன்பிறகு அது திறக்காது.",
  "tutorialFamilyMe": "இது நீங்கள். வேறு யாருக்கும் சொந்தமில்லாத பதிவுகள் உங்களிடமே இருக்கும்.",
  "tutorialFamilyAddPerson": "துணை, குழந்தை அல்லது பெற்றோர் போன்று நீங்கள் கவனித்துக்கொள்பவரைச் சேர்க்க நபரைச் சேர் என்பதைத் தட்டுங்கள்.",
  "tutorialFamilyAddPersonLocked": "குடும்பம் அல்லது வணிகத் திட்டத்தில், நீங்கள் கவனித்துக்கொள்பவர்களைச் சேர்த்து, அவர்களின் பதிவுகளையும் இங்கே வைத்திருக்கலாம்.",
  "tutorialFamilyRecordPerson": "ஒரு பதிவைச் சேர்க்கும்போது அல்லது திருத்தும்போது, மேலும் விவரங்கள் என்பதைத் திறந்து பதிவு யாருடையது என்பதைத் தேர்ந்தெடுங்கள். பிறகு அவர்களின் பெயர் பதிவிலும் அதன் நினைவூட்டல்களிலும் தெரியும்.",
  "tutorialPlansTabs": "ஒவ்வொரு திட்டத்திலும் என்ன உள்ளது என்பதைப் பார்க்க தனிப்பட்ட, குடும்பம், வணிகம் ஆகியவற்றுக்கு இடையே மாறுங்கள்.",
  "tutorialPlansBilling": "மாதந்தோறும் அல்லது ஆண்டுதோறும் செலுத்தத் தேர்ந்தெடுங்கள். ஆண்டுதோறும் செலுத்துவது பொதுவாகச் செலவு குறைவு.",
  "calendarLinkTitle": "காலெண்டர் இணைப்பு",
  "calendarLinkTileSubtitle": "உங்கள் காலாவதி தேதிகளை காலெண்டரில் புதுப்பித்த நிலையில் வைத்திருங்கள்",
  "calendarLinkIntro": "Google Calendar, Apple Calendar அல்லது Outlook இல் ஒருமுறை சந்தா சேர்த்தால், உங்கள் காலாவதி தேதிகள் தானாகவே புதுப்பிக்கப்படும்.",
  "calendarLinkPrivacy": "குறிப்புகள் ஒருபோதும் சேர்க்கப்படாது, பூட்டிய பதிவுகள் பெயர் இல்லாமல் காட்டப்படும். இணைப்பு உள்ள எவரும் உங்கள் தேதிகளைப் பார்க்கலாம், எனவே அதை ரகசியமாக வைக்கவும்.",
  "calendarLinkCreate": "இணைப்பை உருவாக்கு",
  "calendarLinkCreating": "உங்கள் இணைப்பை உருவாக்குகிறது",
  "calendarLinkOn": "உங்கள் காலெண்டர் இணைப்பு இயக்கத்தில் உள்ளது",
  "calendarLinkCreatedOn": "{date} அன்று உருவாக்கப்பட்டது",
  "calendarLinkLastChecked": "காலெண்டர் கடைசியாகச் சரிபார்த்தது: {date}",
  "calendarLinkNotChecked": "எந்த காலெண்டரும் இன்னும் இதைச் சரிபார்க்கவில்லை",
  "calendarLinkAddGoogle": "Google Calendar இல் சேர்",
  "calendarLinkAddApple": "Apple அல்லது Outlook இல் சேர்",
  "calendarLinkCopy": "இணைப்பை நகலெடு",
  "calendarLinkCopied": "இணைப்பு நகலெடுக்கப்பட்டது",
  "calendarLinkRotate": "புதிய இணைப்பை உருவாக்கு",
  "calendarLinkRotateTitle": "புதிய இணைப்பை உருவாக்கவா?",
  "calendarLinkRotateBody": "உங்கள் பழைய இணைப்பு வேலை செய்யாது. அதைப் பயன்படுத்தும் காலெண்டர்கள், நீங்கள் புதிய இணைப்பைச் சேர்க்கும் வரை புதுப்பிக்கப்படாது.",
  "calendarLinkRotated": "புதிய இணைப்பு தயார். அதை மீண்டும் உங்கள் காலெண்டரில் சேர்க்கவும்.",
  "calendarLinkTurnOff": "அணை",
  "calendarLinkTurnOffTitle": "உங்கள் காலெண்டர் இணைப்பை அணைக்கவா?",
  "calendarLinkTurnOffBody": "இந்த இணைப்பைப் பயன்படுத்தும் காலெண்டர்கள் புதுப்பிக்கப்படாது. உங்கள் காலெண்டர் ஏற்கெனவே காட்டும் தேதிகளை நீக்கக்கூடும்.",
  "calendarLinkTurnedOff": "காலெண்டர் இணைப்பு அணைக்கப்பட்டது",
  "calendarLinkOtherDevice": "இந்த இணைப்பு வேறொரு சாதனத்தில் உருவாக்கப்பட்டது. இங்கிருந்து காலெண்டரில் சேர்க்க, புதிய இணைப்பை உருவாக்கவும்.",
  "calendarLinkRefreshNote": "காலெண்டர்கள் தங்கள் சொந்த அட்டவணைப்படி மாற்றங்களைச் சரிபார்க்கும், பொதுவாக சில மணிநேரங்களுக்கு ஒருமுறை.",
  "calendarLinkOpenFailed": "இணைப்பைத் திறக்க எந்த ஆப்ஸும் இல்லை. அதை நகலெடுத்து உங்கள் காலெண்டர் ஆப்ஸில் சேர்க்கவும்.",
  "calendarLinkError": "ஏதோ தவறு நடந்துவிட்டது. மீண்டும் முயலவும்.",
  "calendarLinkTryAgain": "மீண்டும் முயல்",
  "calendarLinkPremiumTitle": "நேரடி காலெண்டர் இணைப்பு ஒரு ப்ரீமியம் அம்சம்",
  "calendarLinkPremiumBody": "ஒவ்வொரு காலாவதி தேதியையும் எப்போதும் புதுப்பித்த நிலையில் உங்கள் காலெண்டரில் காண ப்ரீமியத்துக்கு மேம்படுத்துங்கள்.",
  "notificationsEmailSection": "மின்னஞ்சல்",
