  "guideWhenToStart": "எப்போது தொடங்குவது",
  "guideChecklist": "சரிபார்ப்புப் பட்டியல்",
  "guideProgress": "{total}-இல் {done} முடிந்தது",
  "guideTipTitle": "குறிப்பு",
  "guideDisclaimer": "படிகள் நாட்டுக்கு நாடு மாறுபடும். வழங்கும் அமைப்பிடம் சரிபார்க்கவும்.",
  "guideMarkRenewed": "புதுப்பிக்கப்பட்டதாகக் குறி",
  "guidePassportsWhen": "காலாவதிக்கு 9 முதல் 12 மாதங்களுக்கு முன் தொடங்கவும். பல நாடுகளில் நுழைய 6 மாத செல்லுபடி தேவை.",
  "guidePassportsStep1": "தற்போதைய நடைமுறைக்கு வழங்கும் அதிகாரியின் அதிகாரப்பூர்வ இணையதளத்தைப் பார்க்கவும்",
  "guidePassportsStep2": "அதிகாரப்பூர்வ கடவுச்சீட்டு புகைப்பட விதிகளுக்கு ஏற்ற புதிய புகைப்படங்களை எடுக்கவும்",
  "guidePassportsStep3": "விண்ணப்பத்தை நிரப்பி, அடையாள ஆவணத்தையும் தற்போதைய கடவுச்சீட்டையும் தயார் செய்யவும்",
  "guidePassportsStep4": "விண்ணப்பத்தைச் சமர்ப்பித்து, ரசீது அல்லது குறிப்பு எண்ணை வைத்திருக்கவும்",
  "guidePassportsStep5": "பழைய கடவுச்சீட்டை என்ன செய்வது என்று சொல்லப்படும் வரை வைத்திருக்கவும்",
  "guidePassportsTip": "பயணத்துக்கு முன், பழைய கடவுச்சீட்டில் உள்ள செல்லுபடியான விசாக்கள் இன்னும் பயன்படுமா எனப் பார்க்கவும்.",
  "guideIdCardsWhen": "காலாவதிக்கு 2 முதல் 3 மாதங்களுக்கு முன் தொடங்கவும், பயணம் திட்டமிட்டிருந்தால் இன்னும் முன்பே.",
  "guideIdCardsStep1": "அட்டையை வழங்கிய அதிகாரியிடம் எப்படி, எங்கே புதுப்பிப்பது எனக் கேட்கவும்",
  "guideIdCardsStep2": "தற்போதைய அட்டையையும் கேட்கப்படும் முகவரிச் சான்றையும் தயார் செய்யவும்",
  "guideIdCardsStep3": "புகைப்படம் அல்லது கைரேகை எடுக்கப்படலாம் என்பதால் தேவைப்பட்டால் சந்திப்பை முன்பதிவு செய்யவும்",
  "guideIdCardsStep4": "புதிய அட்டை வந்ததும் எல்லா விவரங்களும் சரியா எனச் சரிபார்க்கவும்",
  "guideIdCardsTip": "புதிய அட்டை வந்ததும் உங்கள் வங்கி, முதலாளி மற்றும் பிறருக்கு அதன் விவரங்கள் தேவைப்படலாம்.",
  "guideResidencePermitsWhen": "விதிகள் அனுமதிக்கும் அளவுக்கு முன்பே தொடங்கவும், பெரும்பாலும் காலாவதிக்கு 3 முதல் 4 மாதங்களுக்கு முன்.",
  "guideResidencePermitsStep1": "குடிவரவு அதிகாரியின் புதுப்பித்தல் விதிகளையும் காலக்கெடுவையும் சரிபார்க்கவும்",
  "guideResidencePermitsStep2": "கடவுச்சீட்டு, தற்போதைய அனுமதி, நீங்கள் இன்னும் தகுதியானவர் என்பதற்கான சான்றைத் தயார் செய்யவும்",
  "guideResidencePermitsStep3": "தற்போதைய அனுமதி காலாவதியாகும் முன் விண்ணப்பத்தைச் சமர்ப்பிக்கவும்",
  "guideResidencePermitsStep4": "புதிய அனுமதி வரும் வரை விண்ணப்பித்ததற்கான சான்றை உடன் வைத்திருக்கவும்",
  "guideResidencePermitsTip": "தாமதமாக விண்ணப்பிப்பது தங்கும் உரிமையைப் பாதிக்கலாம். சந்தேகம் இருந்தால் குடிவரவு அதிகாரியிடம் கேட்கவும்.",
  "guideDrivingLicencesWhen": "காலாவதிக்கு 1 முதல் 3 மாதங்களுக்கு முன் தொடங்கவும்.",
  "guideDrivingLicencesStep1": "உரிமம் வழங்கும் அதிகாரியின் நடைமுறையையும் ஆன்லைனில் புதுப்பிக்க முடியுமா என்பதையும் சரிபார்க்கவும்",
  "guideDrivingLicencesStep2": "தற்போதைய உரிமம், அடையாள ஆவணம், தேவையான புகைப்படங்களைத் தயார் செய்யவும்",
  "guideDrivingLicencesStep3": "தேவைப்பட்டால் கண் பரிசோதனை அல்லது மருத்துவப் பரிசோதனைக்கு முன்பதிவு செய்யவும்",
  "guideDrivingLicencesStep4": "காத்திருக்கும்போது தற்காலிக உரிமம் அல்லது ரசீதை உடன் வைத்திருக்கவும்",
  "guideDrivingLicencesTip": "காலாவதியான உரிமத்துடன் ஓட்டுவது காப்பீட்டுப் பாதுகாப்பைப் பாதிக்கலாம். சரியான நேரத்தில் புதுப்பிக்கவும்.",
  "guideVehicleRegistrationsWhen": "காலாவதிக்குச் சுமார் 1 மாதத்துக்கு முன் தொடங்கவும்.",
  "guideVehicleRegistrationsStep1": "புதுப்பித்தல் அறிவிப்பு அல்லது வாகன உரிம அதிகாரியின் இணையதளத்தைப் பார்க்கவும்",
  "guideVehicleRegistrationsStep2": "தேவையான சோதனை அல்லது காப்பீடு முதலில் செல்லுபடியாக உள்ளதா என உறுதிசெய்யவும்",
  "guideVehicleRegistrationsStep3": "வாகன ஆவணங்கள், அடையாள ஆவணம், கேட்டால் முகவரிச் சான்றைத் தயார் செய்யவும்",
  "guideVehicleRegistrationsStep4": "புதுப்பித்தலை முடித்து, புதிய சான்றை விதிப்படி வைத்திருக்கவும் அல்லது காட்சிப்படுத்தவும்",
  "guideVehicleRegistrationsTip": "சில இடங்களில் புதுப்பிக்கும் முன் செல்லுபடியான சாலைத் தகுதி அல்லது புகை உமிழ்வுச் சோதனை தேவை.",
  "guideRoadworthyCertificatesWhen": "காலாவதிக்கு 2 முதல் 4 வாரங்களுக்கு முன் அல்லது வாகனத்தை விற்கும் முன் சோதனைக்கு முன்பதிவு செய்யவும்.",
  "guideRoadworthyCertificatesStep1": "உங்கள் வாகன வகைக்கு அங்கீகரிக்கப்பட்ட சோதனை மையத்தைக் கண்டறியவும்",
  "guideRoadworthyCertificatesStep2": "சோதனைக்கு முன் விளக்குகள், டயர்கள், பிரேக்குகள், வைப்பர்கள், கண்ணாடிகளைச் சரிபார்க்கவும்",
  "guideRoadworthyCertificatesStep3": "வாகன ஆவணங்களையும் அடையாள ஆவணத்தையும் சந்திப்புக்கு எடுத்துச் செல்லவும்",
  "guideRoadworthyCertificatesStep4": "வாகனம் தோல்வியடைந்தால், குறிப்பிட்டவற்றைச் சரிசெய்து மறுசோதனைக்கு முன்பதிவு செய்யவும்",
  "guideRoadworthyCertificatesTip": "சான்றிதழ்கள் பெரும்பாலும் குறுகிய காலமே செல்லும், எனவே தேவைப்படும் நேரத்துக்கு அருகில் முன்பதிவு செய்யவும்.",
  "guideVisasWhen": "அனுமதிக்கப்படும் அளவுக்கு முன்பே தொடங்கவும். செயலாக்கத்துக்கு வாரங்கள் அல்லது மாதங்கள் ஆகலாம்.",
  "guideVisasStep1": "உங்கள் விசாவை நீட்டிக்க முடியுமா அல்லது புதியது தேவையா எனச் சரிபார்க்கவும்",
  "guideVisasStep2": "புதிய விசாவுக்குப் போதுமான காலம் கடவுச்சீட்டு செல்லுபடியாக இருப்பதை உறுதிசெய்யவும்",
  "guideVisasStep3": "கடவுச்சீட்டு, தற்போதைய விசா, துணை ஆவணங்களைத் தயார் செய்யவும்",
  "guideVisasStep4": "அதிகாரப்பூர்வ வழிகளில் மட்டுமே விண்ணப்பித்து குறிப்பு எண்ணை வைத்திருக்கவும்",
  "guideVisasTip": "விசா காலாவதியான பின் தங்குவது கடுமையான சிக்கல்களை ஏற்படுத்தலாம். சந்தேகம் இருந்தால் முன்பே ஆலோசனை பெறவும்.",
  "guideStudyPermitsWhen": "காலாவதிக்கு 2 முதல் 3 மாதங்களுக்கு முன், அல்லது கூடுதல் நேரம் தேவை என்று தெரிந்தவுடன் தொடங்கவும்.",
  "guideStudyPermitsStep1": "புதுப்பித்தல் நடைமுறை பற்றி உங்கள் கல்வி நிறுவனத்தின் சர்வதேச அலுவலகத்திடம் கேட்கவும்",
  "guideStudyPermitsStep2": "உங்கள் சேர்க்கையையும் படிப்புக் காலத்தையும் உறுதிப்படுத்தும் கடிதத்தைப் பெறவும்",
  "guideStudyPermitsStep3": "கடவுச்சீட்டு, தற்போதைய அனுமதி, தேவைப்பட்டால் நிதிச் சான்றைத் தயார் செய்யவும்",
  "guideStudyPermitsStep4": "தற்போதைய அனுமதி காலாவதியாகும் முன் சமர்ப்பித்து, விண்ணப்பித்ததற்கான சான்றை வைத்திருக்கவும்",
  "guideStudyPermitsTip": "கடவுச்சீட்டையும் சரிபார்க்கவும். அது முழுப் படிப்புக் காலத்துக்கும் செல்லுபடியாக இருக்க வேண்டியிருக்கலாம்.",
  "guideWorkPermitsWhen": "காலாவதிக்கு 3 முதல் 4 மாதங்களுக்கு முன் தொடங்கவும்.",
  "guideWorkPermitsStep1": "உங்கள் விண்ணப்பத்துக்கு முதலாளியின் ஆதரவு தேவைப்படலாம் என்பதால் முன்பே தெரிவிக்கவும்",
  "guideWorkPermitsStep2": "அனுமதியைப் புதுப்பிக்கும் குடிவரவு அதிகாரியின் விதிகளைச் சரிபார்க்கவும்",
  "guideWorkPermitsStep3": "கடவுச்சீட்டு, தற்போதைய அனுமதி, ஒப்பந்தம், சமீபத்திய சம்பளச் சீட்டுகளைத் தயார் செய்யவும்",
  "guideWorkPermitsStep4": "தற்போதைய அனுமதி காலாவதியாகும் முன் சமர்ப்பித்து, விண்ணப்பித்ததற்கான சான்றை வைத்திருக்கவும்",
  "guideWorkPermitsTip": "புதிய வேலைக்குப் புதிய அனுமதி தேவைப்படலாம். புதிய பணியை ஏற்கும் முன் சரிபார்க்கவும்.",
  "guideVehicleInsurancesWhen": "புதுப்பித்தல் தேதிக்கு 3 முதல் 4 வாரங்களுக்கு முன் தொடங்கவும்.",
  "guideVehicleInsurancesStep1": "புதுப்பித்தல் அறிவிப்பைப் படித்து, காப்பீட்டுப் பாதுகாப்பையும் விலக்குத் தொகையையும் சரிபார்க்கவும்",
  "guideVehicleInsurancesStep2": "முகவரி, ஓட்டுநர்கள் அல்லது வாகனத்தில் உள்ள மாற்றங்களைக் காப்பீட்டாளரிடம் தெரிவிக்கவும்",
  "guideVehicleInsurancesStep3": "விலை உயர்ந்திருந்தால் சில மேற்கோள்களை ஒப்பிடவும்",
  "guideVehicleInsurancesStep4": "பழைய காப்பீடு முடியும் முன் புதியது தொடங்குவதை உறுதிசெய்யவும்",
  "guideVehicleInsurancesTip": "பல பாலிசிகள் தானாகப் புதுப்பிக்கப்படும். காப்பீடு இல்லாமல் ஓட்டாமல் இருக்க உங்களுடையதைச் சரிபார்க்கவும்.",
  "guidePropertyInsurancesWhen": "புதுப்பித்தல் தேதிக்கு 3 முதல் 4 வாரங்களுக்கு முன் தொடங்கவும்.",
  "guidePropertyInsurancesStep1": "வீடு மற்றும் உடைமைகளின் காப்பீட்டு மதிப்பு இன்னும் சரியா எனச் சரிபார்க்கவும்",
  "guidePropertyInsurancesStep2": "புனரமைப்புகள், புதிய மதிப்புமிக்க பொருட்கள் அல்லது பாதுகாப்பு மாற்றங்களைக் காப்பீட்டாளரிடம் தெரிவிக்கவும்",
  "guidePropertyInsurancesStep3": "மேற்கோள்களை ஒப்பிட்டு, எது காப்பீட்டில் அடங்கும், எது அடங்காது எனப் பார்க்கவும்",
  "guidePropertyInsurancesStep4": "பழைய காப்பீடு முடியும் முன் புதியது தொடங்குவதை உறுதிசெய்யவும்",
  "guidePropertyInsurancesTip": "மதிப்புமிக்க பொருட்களின் புகைப்படங்களையும் ரசீதுகளையும் வைத்திருக்கவும். கோரிக்கை வைக்கும்போது உதவும்.",
  "guideLifeInsurancesWhen": "புதுப்பித்தல் அல்லது மறுஆய்வுத் தேதிக்கு 1 முதல் 2 மாதங்களுக்கு முன் மறுஆய்வு செய்யவும்.",
  "guideLifeInsurancesStep1": "பாலிசி தானாகப் புதுப்பிக்கப்படுமா அல்லது நீங்கள் செயல்பட வேண்டுமா எனச் சரிபார்க்கவும்",
  "guideLifeInsurancesStep2": "திருமணம், குழந்தைகள், புதிய வீடு போன்ற மாற்றங்களுக்குப் பின் காப்பீட்டை மறுஆய்வு செய்யவும்",
  "guideLifeInsurancesStep3": "உங்கள் பயனாளிகள் இன்னும் சரியா எனச் சரிபார்க்கவும்",
  "guideLifeInsurancesStep4": "ரத்து செய்யும் அல்லது மாறும் முன் காப்பீட்டாளர் அல்லது ஆலோசகரிடம் பேசவும்",
  "guideLifeInsurancesTip": "புதிய காப்பீடு எழுத்துப்பூர்வமாக உறுதியாகும் வரை தற்போதையதைத் தொடரவும்.",
  "guideHealthInsurancesWhen": "புதுப்பித்தல் தேதிக்கு 1 முதல் 2 மாதங்களுக்கு முன் தொடங்கவும்.",
  "guideHealthInsurancesStep1": "காப்பீடு மற்றும் பலன்களில் உள்ள மாற்றங்களுக்குப் புதுப்பித்தல் அறிவிப்பைப் படிக்கவும்",
  "guideHealthInsurancesStep2": "வரும் ஆண்டில் நீங்கள் எதிர்பார்க்கும் சிகிச்சை அல்லது பராமரிப்பைப் பற்றி யோசிக்கவும்",
  "guideHealthInsurancesStep3": "காத்திருப்புக் காலங்கள், விலக்குகள் உட்படத் திட்டங்களை ஒப்பிடவும்",
  "guideHealthInsurancesStep4": "காப்பீடு தொடர காலக்கெடுவுக்கு முன் உங்கள் தேர்வை உறுதிப்படுத்தவும்",
  "guideHealthInsurancesTip": "திட்டத்தை மாற்றினால் புதிய காத்திருப்புக் காலங்கள் வரலாம். மாறும் முன் சரிபார்க்கவும்.",
  "guideTravelInsurancesWhen": "ஆண்டுக் காப்பீடு: காலாவதிக்கு 2 வாரம் முன் தொடங்கவும். ஒரு பயணத்துக்கு: முன்பதிவின்போதே ஏற்பாடு செய்யவும்.",
  "guideTravelInsurancesStep1": "பயணத் தேதிகளும் எல்லா இடங்களும் காப்பீட்டில் அடங்குகின்றனவா எனச் சரிபார்க்கவும்",
  "guideTravelInsurancesStep2": "மருத்துவம், ரத்து, பயணப்பை காப்பீட்டைச் சரிபார்க்கவும்",
  "guideTravelInsurancesStep3": "பனிச்சறுக்கு, நீர்மூழ்கல் போன்ற செயல்பாடுகளைக் காப்பீட்டாளரிடம் தெரிவிக்கவும்",
  "guideTravelInsurancesStep4": "பாலிசியையும் அவசர எண்ணையும் உங்கள் ஃபோனில் சேமிக்கவும்",
  "guideTravelInsurancesTip": "சில நாடுகள் நுழைய பயணக் காப்பீட்டுச் சான்று கேட்கின்றன. செல்லும் முன் சரிபார்க்கவும்.",
  "guideDebitAndCreditCardsWhen": "அட்டையில் உள்ள காலாவதி தேதிக்கு 4 முதல் 6 வாரங்களுக்கு முன் சரிபார்க்கவும்.",
  "guideDebitAndCreditCardsStep1": "வங்கிகள் பெரும்பாலும் தானாக அனுப்புவதால் புதிய அட்டைக்காகக் கவனமாக இருக்கவும்",
  "guideDebitAndCreditCardsStep2": "காலாவதிக்கு 2 வாரங்களுக்கு முன்னும் வரவில்லை என்றால் வங்கியைத் தொடர்புகொள்ளவும்",
  "guideDebitAndCreditCardsStep3": "வங்கி சொல்லும் முறையில் புதிய அட்டையைச் செயல்படுத்தவும்",
  "guideDebitAndCreditCardsStep4": "சந்தாக்களிலும் சேமித்த கட்டணங்களிலும் அட்டை விவரங்களை மாற்றவும்",
  "guideDebitAndCreditCardsStep5": "புதிய அட்டை வேலை செய்ததும் பழையதை அழிக்கவும்",
  "guideDebitAndCreditCardsTip": "உங்கள் வங்கி ஒருபோதும் உங்கள் PIN-ஐக் கேட்காது. அப்படிக் கேட்கும் அழைப்புகளையோ செய்திகளையோ புறக்கணிக்கவும்.",
  "guideStoreCardsWhen": "காலாவதிக்குச் சுமார் 1 மாதத்துக்கு முன் சரிபார்க்கவும்.",
  "guideStoreCardsStep1": "கடை புதிய அட்டை அனுப்புமா அல்லது அதன் செயலிக்கு மாற்றுமா எனச் சரிபார்க்கவும்",
  "guideStoreCardsStep2": "புள்ளிகள் அல்லது இருப்பு புதிய அட்டைக்கு மாற்றப்படுவதை உறுதிசெய்யவும்",
  "guideStoreCardsStep3": "கடையில் உங்கள் தொடர்பு விவரங்களை மாற்றவும்",
  "guideStoreCardsStep4": "காலாவதிக்கு முன் எதுவும் வரவில்லை என்றால் கடையைத் தொடர்புகொள்ளவும்",
  "guideStoreCardsTip": "பழைய அட்டையுடன் காலாவதியாகக்கூடிய புள்ளிகள் அல்லது வவுச்சர்களைப் பயன்படுத்திவிடவும்.",
  "guideProfessionalLicencesWhen": "காலாவதிக்கு 2 முதல் 3 மாதங்களுக்கு முன் தொடங்கவும்.",
  "guideProfessionalLicencesStep1": "உங்கள் தொழில்முறை அமைப்பின் புதுப்பித்தல் தேவைகளையும் காலக்கெடுவையும் சரிபார்க்கவும்",
  "guideProfessionalLicencesStep2": "தேவையான பயிற்சி அல்லது கல்வி மணிநேரங்கள் முடிந்ததை உறுதிசெய்யவும்",
  "guideProfessionalLicencesStep3": "கேட்கப்படும் சான்றிதழ்களையும் பணி அனுபவச் சான்றையும் தயார் செய்யவும்",
  "guideProfessionalLicencesStep4": "புதுப்பித்தலைச் சமர்ப்பித்து உறுதிப்படுத்தலை வைத்திருக்கவும்",
  "guideProfessionalLicencesTip": "புதுப்பித்தல் அவசரமாகாமல் இருக்க ஆண்டு முழுவதும் பயிற்சி மணிநேரங்களைக் கண்காணிக்கவும்.",
  "guideWorkAccessCardsWhen": "காலாவதிக்கு 2 முதல் 4 வாரங்களுக்கு முன் தொடங்கவும்.",
  "guideWorkAccessCardsStep1": "அணுகல் அட்டையை எப்படிப் புதுப்பிப்பது எனப் பாதுகாப்பு அல்லது HR குழுவிடம் கேட்கவும்",
  "guideWorkAccessCardsStep2": "தேவையான பயிற்சி, சரிபார்ப்புகள் அல்லது படிவங்களை முடிக்கவும்",
  "guideWorkAccessCardsStep3": "புதிய புகைப்படம் அல்லது அட்டை தேவைப்பட்டால் அடையாள ஆவணத்தை எடுத்துச் செல்லவும்",
  "guideWorkAccessCardsStep4": "கேட்கப்பட்டால் பழைய அட்டையைத் திருப்பிக் கொடுக்கவும்",
  "guideWorkAccessCardsTip": "சில இடங்களில் வாரக்கணக்கில் ஆகும் பின்னணிச் சரிபார்ப்பு தேவை. முன்பே கேட்கவும்.",
  "guideLeaseAgreementsWhen": "குத்தகை முடிவதற்கு 2 முதல் 3 மாதங்களுக்கு முன், அல்லது அறிவிப்புக் காலம் தொடங்கும் முன் தொடங்கவும்.",
  "guideLeaseAgreementsStep1": "ஒப்பந்தத்தில் அறிவிப்புக் காலத்தையும் புதுப்பித்தல் நிபந்தனைகளையும் சரிபார்க்கவும்",
  "guideLeaseAgreementsStep2": "தங்குகிறீர்களா வெளியேறுகிறீர்களா என்பதை உரிமையாளர் அல்லது முகவரிடம் எழுத்துமூலம் தெரிவிக்கவும்",
  "guideLeaseAgreementsStep3": "புதிய ஒப்பந்தத்தை, குறிப்பாக வாடகையையும் காலத்தையும் கவனமாகப் படிக்கவும்",
  "guideLeaseAgreementsStep4": "புதிய ஒப்பந்தத்தின் கையொப்பமிட்ட நகல்களையும் உங்கள் செய்திகளையும் வைத்திருக்கவும்",
  "guideLeaseAgreementsTip": "வெளியேறுகிறீர்களா? வைப்புத்தொகையைத் திரும்பப் பெற தேதியிட்ட புகைப்படங்களை எடுக்கவும்.",
  "guideAccessCardsAndTagsWhen": "காலாவதிக்கு 2 முதல் 4 வாரங்களுக்கு முன் சரிபார்க்கவும்.",
  "guideAccessCardsAndTagsStep1": "அதை வழங்கிய கட்டடம், குடியிருப்பு, உடற்பயிற்சிக் கூடம் அல்லது கிளப்பைத் தொடர்புகொள்ளவும்",
  "guideAccessCardsAndTagsStep2": "அடையாள ஆவணம் அல்லது அங்கு வசிப்பதற்கான அல்லது உறுப்பினர் சான்று போன்ற தேவைகளைக் கேட்கவும்",
  "guideAccessCardsAndTagsStep3": "புதிய அட்டை அல்லது குறிச்சொல்லைப் பெற அல்லது செயல்படுத்த ஏற்பாடு செய்யவும்",
  "guideAccessCardsAndTagsStep4": "பழையது வேலை செய்வதை நிறுத்தும் முன் புதியதைச் சோதிக்கவும்",
  "guideAccessCardsAndTagsTip": "தொலைந்த அட்டை அல்லது குறிச்சொல்லை முடக்க உடனே புகாரளிக்கவும்.",
