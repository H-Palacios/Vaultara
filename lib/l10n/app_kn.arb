  "guideVisasWhen": "ಅನುಮತಿಸಿದಷ್ಟು ಬೇಗ ಪ್ರಾರಂಭಿಸಿ. ಪ್ರಕ್ರಿಯೆಗೆ ವಾರಗಳು ಅಥವಾ ತಿಂಗಳುಗಳೇ ಬೇಕಾಗಬಹುದು.",
  "guideVisasStep1": "ನಿಮ್ಮ ವೀಸಾವನ್ನು ವಿಸ್ತರಿಸಬಹುದೇ ಅಥವಾ ಹೊಸದು ಬೇಕೇ ಎಂದು ಪರಿಶೀಲಿಸಿ",
  "guideVisasStep2": "ಹೊಸ ವೀಸಾಗೆ ಸಾಕಷ್ಟು ಕಾಲ ನಿಮ್ಮ ಪಾಸ್‌ಪೋರ್ಟ್ ಮಾನ್ಯವಾಗಿರುವಂತೆ ಖಚಿತಪಡಿಸಿ",
  "guideVisasStep3": "ಪಾಸ್‌ಪೋರ್ಟ್, ಪ್ರಸ್ತುತ ವೀಸಾ ಮತ್ತು ಪೂರಕ ದಾಖಲೆಪತ್ರಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಿ",
  "guideVisasStep4": "ಅಧಿಕೃತ ಮಾರ್ಗಗಳ ಮೂಲಕ ಮಾತ್ರ ಅರ್ಜಿ ಸಲ್ಲಿಸಿ ಮತ್ತು ಉಲ್ಲೇಖ ಸಂಖ್ಯೆ ಇಟ್ಟುಕೊಳ್ಳಿ",
  "guideVisasTip": "ವೀಸಾ ಮುಕ್ತಾಯದ ನಂತರ ಉಳಿದರೆ ಗಂಭೀರ ಸಮಸ್ಯೆಗಳಾಗಬಹುದು. ಸಂದೇಹವಿದ್ದರೆ ಬೇಗ ಸಲಹೆ ಪಡೆಯಿರಿ.",
  "guideStudyPermitsWhen": "ಮುಕ್ತಾಯಕ್ಕೆ 2 ರಿಂದ 3 ತಿಂಗಳ ಮೊದಲು, ಅಥವಾ ಹೆಚ್ಚು ಸಮಯ ಬೇಕೆಂದು ತಿಳಿದ ತಕ್ಷಣ ಪ್ರಾರಂಭಿಸಿ.",
  "guideStudyPermitsStep1": "ನವೀಕರಣ ಪ್ರಕ್ರಿಯೆ ಬಗ್ಗೆ ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಅಂತರರಾಷ್ಟ್ರೀಯ ಕಚೇರಿಯನ್ನು ಕೇಳಿ",
  "guideStudyPermitsStep2": "ನಿಮ್ಮ ದಾಖಲಾತಿ ಮತ್ತು ಅಧ್ಯಯನ ಅವಧಿಯನ್ನು ದೃಢೀಕರಿಸುವ ಪತ್ರ ಪಡೆಯಿರಿ",
  "guideStudyPermitsStep3": "ಪಾಸ್‌ಪೋರ್ಟ್, ಪ್ರಸ್ತುತ ಪರವಾನಗಿ ಮತ್ತು ಅಗತ್ಯವಿದ್ದರೆ ಹಣಕಾಸಿನ ಪುರಾವೆ ಸಿದ್ಧಪಡಿಸಿ",
  "guideStudyPermitsStep4": "ಪ್ರಸ್ತುತ ಪರವಾನಗಿ ಮುಕ್ತಾಯಕ್ಕೆ ಮೊದಲು ಸಲ್ಲಿಸಿ, ಅರ್ಜಿಯ ಪುರಾವೆ ಇಟ್ಟುಕೊಳ್ಳಿ",
  "guideStudyPermitsTip": "ನಿಮ್ಮ ಪಾಸ್‌ಪೋರ್ಟ್ ಕೂಡ ಪರಿಶೀಲಿಸಿ. ಅದು ಇಡೀ ಅಧ್ಯಯನ ಅವಧಿಗೆ ಮಾನ್ಯವಾಗಿರಬೇಕಾಗಬಹುದು.",
  "guideWorkPermitsWhen": "ಮುಕ್ತಾಯಕ್ಕೆ 3 ರಿಂದ 4 ತಿಂಗಳ ಮೊದಲು ಪ್ರಾರಂಭಿಸಿ.",
  "guideWorkPermitsStep1": "ಉದ್ಯೋಗದಾತರಿಗೆ ಬೇಗ ತಿಳಿಸಿ, ನಿಮ್ಮ ಅರ್ಜಿಗೆ ಅವರ ಬೆಂಬಲ ಬೇಕಾಗಬಹುದು",
  "guideWorkPermitsStep2": "ಪರವಾನಗಿ ನವೀಕರಣಕ್ಕೆ ವಲಸೆ ಪ್ರಾಧಿಕಾರದ ನಿಯಮಗಳನ್ನು ಪರಿಶೀಲಿಸಿ",
  "guideWorkPermitsStep3": "ಪಾಸ್‌ಪೋರ್ಟ್, ಪ್ರಸ್ತುತ ಪರವಾನಗಿ, ಒಪ್ಪಂದ ಮತ್ತು ಇತ್ತೀಚಿನ ವೇತನ ಚೀಟಿಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಿ",
  "guideWorkPermitsStep4": "ಪ್ರಸ್ತುತ ಪರವಾನಗಿ ಮುಕ್ತಾಯಕ್ಕೆ ಮೊದಲು ಸಲ್ಲಿಸಿ, ಅರ್ಜಿಯ ಪುರಾವೆ ಇಟ್ಟುಕೊಳ್ಳಿ",
  "guideWorkPermitsTip": "ಹೊಸ ಕೆಲಸಕ್ಕೆ ಹೊಸ ಪರವಾನಗಿ ಬೇಕಾಗಬಹುದು. ಹೊಸ ಹುದ್ದೆ ಒಪ್ಪುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ.",
  "guideVehicleInsurancesWhen": "ನವೀಕರಣ ದಿನಾಂಕಕ್ಕೆ 3 ರಿಂದ 4 ವಾರಗಳ ಮೊದಲು ಪ್ರಾರಂಭಿಸಿ.",
  "guideVehicleInsurancesStep1": "ನವೀಕರಣ ಸೂಚನೆ ಓದಿ, ರಕ್ಷಣೆ ಮತ್ತು ಹೆಚ್ಚುವರಿ ಮೊತ್ತವನ್ನು ಪರಿಶೀಲಿಸಿ",
  "guideVehicleInsurancesStep2": "ವಿಳಾಸ, ಚಾಲಕರು ಅಥವಾ ವಾಹನದ ಬದಲಾವಣೆಗಳನ್ನು ವಿಮಾದಾರರಿಗೆ ತಿಳಿಸಿ",
  "guideVehicleInsurancesStep3": "ಬೆಲೆ ಏರಿದ್ದರೆ ಕೆಲವು ಕೊಟೇಶನ್‌ಗಳನ್ನು ಹೋಲಿಸಿ",
  "guideVehicleInsurancesStep4": "ಹಳೆಯ ರಕ್ಷಣೆ ಮುಗಿಯುವ ಮೊದಲೇ ಹೊಸದು ಪ್ರಾರಂಭವಾಗುವಂತೆ ಖಚಿತಪಡಿಸಿ",
  "guideVehicleInsurancesTip": "ಅನೇಕ ಪಾಲಿಸಿಗಳು ತಾವಾಗಿಯೇ ನವೀಕರಣಗೊಳ್ಳುತ್ತವೆ. ವಿಮೆ ಇಲ್ಲದೆ ಎಂದಿಗೂ ಚಾಲನೆ ಮಾಡದಂತೆ ನಿಮ್ಮದನ್ನು ಪರಿಶೀಲಿಸಿ.",
  "guidePropertyInsurancesWhen": "ನವೀಕರಣ ದಿನಾಂಕಕ್ಕೆ 3 ರಿಂದ 4 ವಾರಗಳ ಮೊದಲು ಪ್ರಾರಂಭಿಸಿ.",
  "guidePropertyInsurancesStep1": "ಮನೆ ಮತ್ತು ವಸ್ತುಗಳ ವಿಮಾ ಮೌಲ್ಯ ಇನ್ನೂ ಸರಿಯಾಗಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ",
  "guidePropertyInsurancesStep2": "ನವೀಕರಣ ಕಾಮಗಾರಿ, ಹೊಸ ಬೆಲೆಬಾಳುವ ವಸ್ತುಗಳು ಅಥವಾ ಭದ್ರತಾ ಬದಲಾವಣೆಗಳನ್ನು ವಿಮಾದಾರರಿಗೆ ತಿಳಿಸಿ",
  "guidePropertyInsurancesStep3": "ಕೊಟೇಶನ್‌ಗಳನ್ನು ಹೋಲಿಸಿ, ಯಾವುದಕ್ಕೆ ರಕ್ಷಣೆ ಇದೆ ಮತ್ತು ಇಲ್ಲ ಎಂದು ಪರಿಶೀಲಿಸಿ",
  "guidePropertyInsurancesStep4": "ಹಳೆಯ ರಕ್ಷಣೆ ಮುಗಿಯುವ ಮೊದಲೇ ಹೊಸದು ಪ್ರಾರಂಭವಾಗುವಂತೆ ಖಚಿತಪಡಿಸಿ",
  "guidePropertyInsurancesTip": "ಬೆಲೆಬಾಳುವ ವಸ್ತುಗಳ ಫೋಟೋಗಳು ಮತ್ತು ರಶೀದಿಗಳನ್ನು ಇಟ್ಟುಕೊಳ್ಳಿ. ಕ್ಲೈಮ್ ಮಾಡುವಾಗ ಅವು ಸಹಾಯ ಮಾಡುತ್ತವೆ.",
  "guideLifeInsurancesWhen": "ನವೀಕರಣ ಅಥವಾ ಪರಿಶೀಲನಾ ದಿನಾಂಕಕ್ಕೆ 1 ರಿಂದ 2 ತಿಂಗಳ ಮೊದಲು ಪರಿಶೀಲಿಸಿ.",
  "guideLifeInsurancesStep1": "ನಿಮ್ಮ ಪಾಲಿಸಿ ತಾನಾಗಿಯೇ ನವೀಕರಣಗೊಳ್ಳುತ್ತದೆಯೇ ಅಥವಾ ನೀವು ಏನಾದರೂ ಮಾಡಬೇಕೇ ಎಂದು ನೋಡಿ",
  "guideLifeInsurancesStep2": "ಮದುವೆ, ಮಕ್ಕಳು ಅಥವಾ ಹೊಸ ಮನೆಯಂತಹ ಬದಲಾವಣೆಗಳ ನಂತರ ರಕ್ಷಣೆಯನ್ನು ಪರಿಶೀಲಿಸಿ",
  "guideLifeInsurancesStep3": "ನಿಮ್ಮ ಫಲಾನುಭವಿಗಳು ಇನ್ನೂ ಸರಿಯಾಗಿದ್ದಾರೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ",
  "guideLifeInsurancesStep4": "ರದ್ದುಮಾಡುವ ಅಥವಾ ಬದಲಾಯಿಸುವ ಮೊದಲು ವಿಮಾದಾರ ಅಥವಾ ಸಲಹೆಗಾರರೊಂದಿಗೆ ಮಾತನಾಡಿ",
  "guideLifeInsurancesTip": "ಹೊಸ ರಕ್ಷಣೆ ಲಿಖಿತವಾಗಿ ದೃಢೀಕರಿಸುವವರೆಗೆ ಪ್ರಸ್ತುತ ರಕ್ಷಣೆಯನ್ನು ಮುಂದುವರಿಸಿ.",
  "guideHealthInsurancesWhen": "ನವೀಕರಣ ದಿನಾಂಕಕ್ಕೆ 1 ರಿಂದ 2 ತಿಂಗಳ ಮೊದಲು ಪ್ರಾರಂಭಿಸಿ.",
  "guideHealthInsurancesStep1": "ರಕ್ಷಣೆ ಮತ್ತು ಪ್ರಯೋಜನಗಳ ಬದಲಾವಣೆಗಳಿಗಾಗಿ ನವೀಕರಣ ಸೂಚನೆ ಓದಿ",
  "guideHealthInsurancesStep2": "ಮುಂದಿನ ವರ್ಷ ನಿಮಗೆ ಬೇಕಾಗಬಹುದಾದ ಆರೈಕೆ ಅಥವಾ ಚಿಕಿತ್ಸೆಯ ಬಗ್ಗೆ ಯೋಚಿಸಿ",
  "guideHealthInsurancesStep3": "ಕಾಯುವ ಅವಧಿ ಮತ್ತು ಹೊರಗಿಡುವಿಕೆಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪ್ಲಾನ್‌ಗಳನ್ನು ಹೋಲಿಸಿ",
  "guideHealthInsurancesStep4": "ರಕ್ಷಣೆ ಮುಂದುವರಿಯಲು ಗಡುವಿನ ಮೊದಲು ನಿಮ್ಮ ಆಯ್ಕೆಯನ್ನು ದೃಢೀಕರಿಸಿ",
  "guideHealthInsurancesTip": "ಪ್ಲಾನ್ ಬದಲಿಸಿದರೆ ಹೊಸ ಕಾಯುವ ಅವಧಿಗಳು ಬರಬಹುದು. ಬದಲಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ.",
  "guideTravelInsurancesWhen": "ವಾರ್ಷಿಕ ರಕ್ಷಣೆಗೆ ಮುಕ್ತಾಯಕ್ಕೆ 2 ವಾರ ಮೊದಲು ಪ್ರಾರಂಭಿಸಿ. ಒಂದು ಪ್ರಯಾಣಕ್ಕೆ, ಬುಕ್ ಮಾಡುವಾಗಲೇ ವ್ಯವಸ್ಥೆ ಮಾಡಿ.",
  "guideTravelInsurancesStep1": "ಪ್ರಯಾಣದ ದಿನಾಂಕಗಳು ಮತ್ತು ಎಲ್ಲಾ ಗಮ್ಯಸ್ಥಾನಗಳಿಗೆ ರಕ್ಷಣೆ ಇದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಿ",
  "guideTravelInsurancesStep2": "ವೈದ್ಯಕೀಯ, ರದ್ದತಿ ಮತ್ತು ಲಗೇಜ್ ರಕ್ಷಣೆಯನ್ನು ಪರಿಶೀಲಿಸಿ",
  "guideTravelInsurancesStep3": "ಸ್ಕೀಯಿಂಗ್ ಅಥವಾ ಡೈವಿಂಗ್‌ನಂತಹ ಚಟುವಟಿಕೆಗಳ ಬಗ್ಗೆ ವಿಮಾದಾರರಿಗೆ ತಿಳಿಸಿ",
  "guideTravelInsurancesStep4": "ಪಾಲಿಸಿ ಮತ್ತು ತುರ್ತು ಸಂಖ್ಯೆಯನ್ನು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ ಸೇವ್ ಮಾಡಿ",
  "guideTravelInsurancesTip": "ಕೆಲವು ದೇಶಗಳು ಪ್ರವೇಶಕ್ಕೆ ಪ್ರಯಾಣ ವಿಮೆಯ ಪುರಾವೆ ಕೇಳುತ್ತವೆ. ಹೊರಡುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ.",
  "guideDebitAndCreditCardsWhen": "ಕಾರ್ಡ್‌ನ ಮುಕ್ತಾಯ ದಿನಾಂಕಕ್ಕೆ 4 ರಿಂದ 6 ವಾರಗಳ ಮೊದಲು ಪರಿಶೀಲಿಸಿ.",
  "guideDebitAndCreditCardsStep1": "ಹೊಸ ಕಾರ್ಡ್‌ಗಾಗಿ ಗಮನವಿಡಿ, ಬ್ಯಾಂಕ್‌ಗಳು ಸಾಮಾನ್ಯವಾಗಿ ಅದನ್ನು ತಾವಾಗಿಯೇ ಕಳುಹಿಸುತ್ತವೆ",
  "guideDebitAndCreditCardsStep2": "ಮುಕ್ತಾಯಕ್ಕೆ 2 ವಾರ ಮೊದಲು ಬರದಿದ್ದರೆ ಬ್ಯಾಂಕ್ ಸಂಪರ್ಕಿಸಿ",
  "guideDebitAndCreditCardsStep3": "ಬ್ಯಾಂಕ್ ತಿಳಿಸಿದ ರೀತಿಯಲ್ಲಿ ಹೊಸ ಕಾರ್ಡ್ ಸಕ್ರಿಯಗೊಳಿಸಿ",
  "guideDebitAndCreditCardsStep4": "ಚಂದಾದಾರಿಕೆಗಳು ಮತ್ತು ಉಳಿಸಿದ ಪಾವತಿಗಳಲ್ಲಿ ಕಾರ್ಡ್ ವಿವರಗಳನ್ನು ಬದಲಾಯಿಸಿ",
  "guideDebitAndCreditCardsStep5": "ಹೊಸ ಕಾರ್ಡ್ ಕೆಲಸ ಮಾಡಿದ ನಂತರ ಹಳೆಯದನ್ನು ನಾಶಮಾಡಿ",
  "guideDebitAndCreditCardsTip": "ನಿಮ್ಮ ಬ್ಯಾಂಕ್ ಎಂದಿಗೂ ನಿಮ್ಮ PIN ಕೇಳುವುದಿಲ್ಲ. ಅದನ್ನು ಕೇಳುವ ಕರೆಗಳು ಅಥವಾ ಸಂದೇಶಗಳನ್ನು ನಿರ್ಲಕ್ಷಿಸಿ.",
  "guideStoreCardsWhen": "ಮುಕ್ತಾಯಕ್ಕೆ ಸುಮಾರು 1 ತಿಂಗಳ ಮೊದಲು ಪರಿಶೀಲಿಸಿ.",
  "guideStoreCardsStep1": "ಸ್ಟೋರ್ ಹೊಸ ಕಾರ್ಡ್ ಕಳುಹಿಸುತ್ತದೆಯೇ ಅಥವಾ ತನ್ನ ಆ್ಯಪ್‌ಗೆ ಸ್ಥಳಾಂತರಿಸುತ್ತದೆಯೇ ಎಂದು ನೋಡಿ",
  "guideStoreCardsStep2": "ನಿಮ್ಮ ಪಾಯಿಂಟ್‌ಗಳು ಅಥವಾ ಬಾಕಿ ಹೊಸ ಕಾರ್ಡ್‌ಗೆ ವರ್ಗಾವಣೆಯಾಗುವಂತೆ ಖಚಿತಪಡಿಸಿ",
  "guideStoreCardsStep3": "ಸ್ಟೋರ್‌ನಲ್ಲಿ ನಿಮ್ಮ ಸಂಪರ್ಕ ವಿವರಗಳನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ",
  "guideStoreCardsStep4": "ಮುಕ್ತಾಯಕ್ಕೆ ಮೊದಲು ಏನೂ ಬರದಿದ್ದರೆ ಸ್ಟೋರ್ ಸಂಪರ್ಕಿಸಿ",
  "guideStoreCardsTip": "ಹಳೆಯ ಕಾರ್ಡ್‌ನೊಂದಿಗೆ ಮುಕ್ತಾಯಗೊಳ್ಳಬಹುದಾದ ಪಾಯಿಂಟ್‌ಗಳು ಅಥವಾ ವೋಚರ್‌ಗಳನ್ನು ಬಳಸಿ.",
  "guideProfessionalLicencesWhen": "ಮುಕ್ತಾಯಕ್ಕೆ 2 ರಿಂದ 3 ತಿಂಗಳ ಮೊದಲು ಪ್ರಾರಂಭಿಸಿ.",
  "guideProfessionalLicencesStep1": "ನಿಮ್ಮ ವೃತ್ತಿಪರ ಸಂಸ್ಥೆಯ ನವೀಕರಣ ಅವಶ್ಯಕತೆಗಳು ಮತ್ತು ಗಡುವನ್ನು ಪರಿಶೀಲಿಸಿ",
  "guideProfessionalLicencesStep2": "ಅಗತ್ಯವಿರುವ ತರಬೇತಿ ಅಥವಾ ಶಿಕ್ಷಣದ ಗಂಟೆಗಳು ಪೂರ್ಣಗೊಂಡಿವೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿ",
