  "smartInsightCloseExpiriesBodyMany": "{extra, plural, =1{{a}, {b} এবং আরও ১টি রেকর্ড {lastDate}-এর মধ্যে শেষ হচ্ছে, যা প্রায় একই সময়ে। কয়েকটি রেকর্ড এত কাছাকাছি হলে একটি ভুলে যাওয়া সহজ।} other{{a}, {b} এবং আরও {extra}টি রেকর্ড {lastDate}-এর মধ্যে শেষ হচ্ছে, যা প্রায় একই সময়ে। কয়েকটি রেকর্ড এত কাছাকাছি হলে একটি ভুলে যাওয়া সহজ।}}",
  "smartInsightQuietPeriodBody": "{days, plural, =1{পরের দিন কোনো কিছুর মেয়াদ শেষ হচ্ছে না। আপনার পরবর্তী শেষ তারিখ হলো {date}।} other{আগামী {days} দিনে কোনো কিছুর মেয়াদ শেষ হচ্ছে না। আপনার পরবর্তী শেষ তারিখ হলো {date}।}}",
  "smartInsightClusterBody": "{count, plural, =1{{category} বিভাগে আপনার ১টি রেকর্ডের মেয়াদ {date} তারিখে শেষ হচ্ছে। এটি এড়িয়ে যাওয়া সহজ।} other{{category} বিভাগে আপনার {count}টি রেকর্ডের মেয়াদ {date}-এর মধ্যে শেষ হচ্ছে। এগুলো এভাবে একত্রিত থাকলে একটি ভুলে যাওয়া সহজ।}}",
