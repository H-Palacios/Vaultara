  "whatsNewBody": "Chekwaa ebe ị na-edebe kaadị gị na nọmba mkpọchi nke ụlọ akụ ọ bụla. Ọ bụrụ na akpa ego gị efuo, ị na-egbochi ihe niile n'ime nkeji ole na ole.",
  "whatsNewDismiss": "Aghọtara m",
  "tutorialAddRecordMoreDetails2": "Nkọwa ndị ọzọ nwere ihe mgbakwunye: ndetu, ikwughachi, oge imegharị, onye nwe ya, ebe ị na-edebe ya, mkpọchi na foto. Mepee ya naanị mgbe ọ dị mkpa.",
  "tutorialAddRecordProtect2": "Kpọchie ndekọ ka ọ chọọ akara mkpịsị aka ma ọ bụ mkpọchi ihuenyo tupu e gosi ya. Họrọ ebe ị na-edebe ya, dịka akpa ego gị, ma tinye foto akwụkwọ ahụ.",
  "tutorialSmartLostWallet2": "Akpa ego furu efu? Hụ ihe niile dị n'ime ya, kpọọ ụlọ akụ ọ bụla site na mmetụ otu ma soro nzọụkwụ maka ndị fọdụrụ.",
  "tutorialSmartLifeEvents2": "Ịkwaga, nwa, ọrụ ọhụrụ ma ọ bụ ihe mberede? Ihe omume ndụ na-enye gị atụmatụ nwere ndekọ, nzọụkwụ na ụbọchị gị.",
  "storySampleQuestion": "Kedu ihe na-agwụ n'afọ a?",
  "storySampleAnswer": "{name} gị na-agwụ na Maachị. Ị chọrọ ncheta otu ọnwa tupu mgbe ahụ?",
  "@storySampleAnswer": {
