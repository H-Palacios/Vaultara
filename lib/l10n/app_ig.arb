  "whatsNewBadge": "Ọhụrụ",
  "whatsNewTitle": "Furu efu ma ọ bụ e zuru ohi",
  "whatsNewBody": "Chekwaa ebe ị na-edebe kaadị gị na nọmba mkpọchi nke ụlọ akụ ọ bụla. Ọ bụrụ na akpa ego gị efuo, ị na-egbochi ihe niile n'ime nkeji ole na ole.",
  "whatsNewDismiss": "Aghọtara m",
  "tutorialAddRecordMoreDetails2": "Nkọwa ndị ọzọ nwere ihe mgbakwunye: ndetu, ikwughachi, onye nwe ya, ebe ị na-edebe ya, mkpọchi na foto. Mepee ya naanị mgbe ọ dị mkpa.",
  "tutorialAddRecordProtect2": "Kpọchie ndekọ ka ọ chọọ akara mkpịsị aka ma ọ bụ mkpọchi ihuenyo tupu e gosi ya. Họrọ ebe ị na-edebe ya, dịka akpa ego gị, ma tinye foto akwụkwọ ahụ.",
  "tutorialSmartLostWallet2": "Akpa ego furu efu? Hụ ihe niile dị n'ime ya, kpọọ ụlọ akụ ọ bụla site na mmetụ otu ma soro nzọụkwụ maka ndị fọdụrụ.",
  "tutorialSmartLifeEvents2": "Ịkwaga, nwa, ọrụ ọhụrụ ma ọ bụ ihe mberede? Ihe omume ndụ na-enye gị atụmatụ nwere ndekọ, nzọụkwụ na ụbọchị gị.",
  "tourHome1Title": "Ụbọchị gị n'otu nlele",
  "tourHome1Body": "Ihuenyo ụlọ na-egosi ihe dị mkpa taa: ihe na-agwụ n'oge na-adịghị anya na ọnụ ọgụgụ ndekọ ị nwere.",
  "tourHome2Title": "Chọta ihe ọ bụla",
  "tourHome2Body": "Ị nwere ike ịpị ọchụchọ ka ịchọta ndekọ site na aha, otu ma ọ bụ mmadụ.",
  "tourHome3Title": "Njem na atụmatụ",
  "tourHome3Body": "Njem ị na-eme atụmatụ na atụmatụ ihe omume ndụ na-aga n'ihu na-apụta ebe a, ya na ihe fọdụrụ.",
  "tourHome4Title": "Enyemaka n'otu mmetụ",
  "tourHome4Body": "Bọtịnụ ọkụ na-emepe «Jụọ Vaultara». Bọtịnụ profaịlụ dị n'akụkụ ya na-emepe profaịlụ, ntọala na nkuzi gị.",
  "tourRenew1Title": "Ncheta bịara",
  "tourRenew1Body": "Tupu ndekọ agwụ, Vaultara na-echetara gị. Ị nwere ike ịpị ncheta ahụ ka imepe ndekọ ahụ.",
  "tourRenew2Title": "Chekwaa ụbọchị ọhụrụ",
  "tourRenew2Body": "Emegharịala? Họrọ ụbọchị ngwụcha ọhụrụ ebe a ma chekwaa. Ncheta gị na-akwaga n'ụbọchị ọhụrụ.",
  "tourRenew3Title": "Ejighị n'aka otu esi eme ya?",
  "tourRenew3Body": "Ọtụtụ ndekọ nwere ndepụta imegharị. Jụọ Vaultara nwere ike ịchọta usoro maka obodo gị, ya na njikọ gọọmentị.",
  "tourRenew4Title": "Hapụ ya ka ọ kwughachi",
  "tourRenew4Body": "Maka ndenye aha na ịkwụ ụgwọ kwa afọ, gbanye Na-emeghari onwe ya ma ụbọchị ga-aga n'ihu n'onwe ya.",
  "tourAsk1Title": "Jụọ n'okwu nke gị",
  "tourAsk1Body": "Jụọ ihe dịka «Kedu ihe na-agwụ n'afọ a?» ma nweta azịza site na ndekọ gị.",
  "tourAsk2Title": "Kwuo okwu kama ịpị",
  "tourAsk2Body": "Ị nwere ike ịpị igwe okwu ma kwuo okwu. Okwu gị na-apụta ka ị na-ekwu ma ị nwere ike iziga ozugbo.",
  "tourAsk3Title": "Ị na-akwado mgbanwe ọ bụla",
  "tourAsk3Body": "Rịọ ka itinye ma ọ bụ gbanwee ndekọ, ị ga-ebu ụzọ hụ kaadị. Ọ dịghị ihe a na-echekwa ruo mgbe ị kwadoro.",
  "tourAsk4Title": "Weghachi mgbanwe ọ bụla",
  "tourAsk4Body": "Ị gbanwere obi? Mgbanwe ọ bụla akwadoro nwere ike iweghachi site na otu kaadị ahụ.",
  "tourAsk5Title": "Gaa n'ihu ebe ị kwụsịrị",
  "tourAsk5Body": "A na-edebe mkparịta ụka ụbọchị 90 na «Akụkọ mkparịta ụka», ajụjụ a tụrụ aro na-enyere gị aka ịmalite.",
  "tourAsk6Title": "Karịa ndekọ",
  "tourAsk6Body": "Ọ nwekwara ike ịhazi njem, tinye ndị mmadụ, chọta usoro imegharị maka obodo gị ma kesaa ndekọ, ya na njikọ na ibe gọọmentị.",
  "tourAskSampleQuestion": "Tinye {name} m. Ọ ga-agwụ na {date}.",
  "tourAskSampleAnswer": "Lee ya. Lelee nkọwa ndị ahụ ma pịa Kwado iji chekwaa ya.",
  "tourWallet1Title": "Kwadebe mbụ",
  "tourWallet1Body": "Mepee kaadị ma ọ bụ akwụkwọ ma họrọ ebe ị na-edebe ya, dịka akpa ego ma ọ bụ akpa gị.",
  "tourWallet2Title": "Chekwaa nọmba mkpọchi",
  "tourWallet2Body": "Tinye nọmba mkpọchi nke ụlọ akụ ọ bụla ugbu a. Ọ dị na kaadị ahụ, nke ị na-agaghị enwe mgbe ị chọrọ ya.",
  "tourWallet3Title": "Ọ bụrụ na ọ furu efu",
  "tourWallet3Body": "Ọ bụrụ na obere akpa ego gị furu efu, pịa bọtịnụ kwesịrị ekwesị ebe a. Vaultara na-egosi ihe niile dị n'ime ya, ka ị mara ihe ị ga-egbochi.",
  "tourWallet4Title": "Gbochie kaadị n'ime nkeji",
  "tourWallet4Body": "Kpọọ ụlọ akụ ọ bụla site na mmetụ otu, kaa kaadị dịka egbochiri ma chekwaa nọmba akụkọ.",
  "tourWallet5Title": "Dochie ma nọrọ na nchekwa",
  "tourWallet5Body": "Dochie akwụkwọ gị, lelee nkwupụta akaụntụ mgbe e chetaara gị ma pịa «Achọtala m ya» ma ọ pụta.",
  "tourLife1Title": "Oge ukwu, otu atụmatụ",
  "tourLife1Body": "Ịkwaga, nwa, ọrụ ọhụrụ ma ọ bụ ihe mberede: họrọ na «Ihe mere n'ọnụ ndụ» ihe na-eme.",
  "tourLife2Title": "Ndekọ gị, ahaziri ahazi",
  "tourLife2Body": "Atụmatụ ahụ na-egosi ndekọ ị ga-emelite, kagbuo ma ọ bụ megharịa, na ndị ị nwere ike ịgbakwunye.",
  "tourLife3Title": "Nzọụkwụ na ụbọchị",
  "tourLife3Body": "Atụmatụ ọ bụla nwekwara nzọụkwụ na-abụghị ndekọ, na ụbọchị mmalite na-agwa gị mgbe ị ga-etinye akwụkwọ ka ihe ọ bụla ghara ịbịa n'azụ.",
  "tourLife4Title": "Mee ka ọ bụrụ nke gị",
  "tourLife4Body": "Tinye nzọụkwụ nke gị, kekọrịta atụmatụ ahụ dịka PDF ma nweta ncheta gburugburu ụbọchị ahụ.",
  "tourPhotos1Title": "Foto akwụkwọ gị",
  "tourPhotos1Body": "Site na ndekọ ahụ, tinye foto n'ihu na azụ kaadị ma ọ bụ akwụkwọ.",
  "tourPhotos2Title": "Ezoro ezo na ekwentị gị",
  "tourPhotos2Body": "Gbanwuo izo foto ma a na-akpọchi ha na ekwentị gị tupu e bulite ha.",
  "tourPhotos3Title": "Kpọchie ndekọ dị nro",
  "tourPhotos3Body": "Kpọchie ndekọ ma ọ ga-arịọ akara mkpịsị aka ma ọ bụ mkpọchi ihuenyo tupu o meghe.",
  "tourPhotos4Title": "Kpọchie ngwa niile",
  "tourPhotos4Body": "Na ntọala nchekwa, gbanwuo mkpọchi ngwa ma zoo ọdịnaya mgbe ị na-agbanwe ngwa.",
  "tourShare1Title": "Kekọrịta otu ndekọ",
  "tourShare1Body": "Mepee ndekọ ma kekọrịta njikọ na-egosi naanị ndekọ ahụ, ọ dịghị ihe ọzọ.",
  "tourShare1BodyMenu": "Na ndekọ ọ bụla, pịa ⋮ ma họrọ {action}. Njikọ ahụ na-egosi naanị ndekọ ahụ, ọ dịghị ihe ọzọ.",
  "tourShare2Title": "Ngwugwu ihe akaebe",
  "tourShare2Body": "Tinye ndekọ ị họọrọ, ya na foto ha, n'otu PDF maka onye nwe ụlọ, ụlọ akụ ma ọ bụ ọfịs.",
  "tourShare3Title": "Nọgide na-achịkwa",
  "tourShare3Body": "«Njikọ ekesara» na-egosi njikọ ọ bụla ị mere. Kwụsị nke ọ bụla n'oge ọ bụla ma ọ gaghị emepe ọzọ.",
  "tourHousehold1Title": "Kpọọ ezinụlọ gị",
  "tourHousehold1Body": "Kekọrịta koodu ma ọ bụ njikọ òkù. Onye ọ bụla na-abanye na akaụntụ nke ya.",
  "tourHousehold2Title": "Otu nchịkọta ndekọ",
  "tourHousehold2Body": "Onye ọ bụla na-ahụ otu ndekọ ekekọrịtara ma na-enweta otu ncheta.",
  "tourHousehold3Title": "Onye nwe ya?",
  "tourHousehold3Body": "Ndekọ ọ bụla nwere ike ịbụ nke mmadụ. Aha ya na-apụta na ya na na ncheta ya.",
  "tourHouseholdRenewBody": "Họrọ onye ga-emeghari ndekọ e kesara. Naanị ya na-enweta ihe ncheta, onye ọ bụla nwekwara ike ịchetara ya n'otu mpịachi.",
  "tourImport1Title": "Nyochaa kaadị",
  "tourImport1Body": "See foto kaadị ma ọ bụ akwụkwọ ma Vaultara ejupụta aha na ụbọchị njedebe maka gị.",
  "tourImport2Title": "Bubata ndepụta",
  "tourImport2Body": "Ị nweelarị mpempe akwụkwọ? Bubata ya ma lelee ahịrị ọ bụla tupu e chekwaa ihe ọ bụla.",
  "tourImportBatchBody": "Na Premium, ị nwere ike nyochaa ruo akwụkwọ 10 n'otu oge ma lelee ha niile tupu echekwa ihe ọ bụla.",
  "tourImport3Title": "Kekọrịta na Vaultara",
  "tourImport3Body": "Kekọrịta foto, PDF ma ọ bụ ederede site na ngwa ọzọ na Vaultara ka ịmalite ndekọ ọhụrụ.",
  "tourCosts1Title": "Na kalịnda gị",
  "tourCosts1Body": "Tinye ụbọchị njedebe na kalịnda ekwentị gị, n'akụkụ atụmatụ gị ndị ọzọ.",
  "tourCosts2Title": "Ọnụ ahịa imegharị",
  "tourCosts2Body": "Tinye ọnụ ahịa imegharị na ndekọ ma Vaultara na-egosi ego ị na-emefu kwa afọ.",
  "tourCosts3Title": "Mee atụmatụ n'ihu",
  "tourCosts3Body": "Hụ ọnwa dị oke ọnụ ka ha na-abịa ka imegharị buru ibu ghara iju gị anya.",
  "tourBusiness1Title": "Soro otu gị",
  "tourBusiness1Body": "Tinye ndị ọrụ ma debe asambodo, ikike na akwụkwọ ikike ha n'otu ebe.",
  "tourBusinessImportBody": "I nwere ndepụta ndị ọrụ? Ị nwere ike ibubata ya site na spreadsheet, ya na aha na email.",
  "tourBusinessClientBody": "Ị nwere ike ịkekọrịta njikọ a na-agụ naanị na onye ahịa, ka ọ hụ na akwụkwọ ndị ọrụ gị ka dị irè.",
  "tourBusinessRolesBody": "Nye onye ọ bụla ọrụ, dịka Onye ọkwọ ụgbọ, ya na akwụkwọ ọ chọrọ. Vaultara na-egosi ihe na-adịghị.",
  "tourBusiness2Title": "Ncheta email",
  "tourBusiness2Body": "Ndị ọrụ na-enweta email tupu akwụkwọ ha agwụ, ọbụlagodi na-enweghị ngwa ahụ.",
  "tourBusiness3Title": "Akụkọ kwa ọnwa",
  "tourBusiness3Body": "Ọnwa ọ bụla akụkọ na-egosi ihe dị irè, ihe na-agwụ na ihe na-efu.",
  "tourBusiness4Title": "Rịọ maka mmelite",
