  "storySampleGym": "Ndị otu ebe mgbatị ahụ",
  "storySampleFirstAid": "Asambodo enyemaka mbụ",
  "storySampleEncrypt": "Zoo foto",
  "storySampleAppLock": "Mkpọchi ngwa",
  "storySampleHideApp": "Zoo ọdịnaya na ngbanwe ngwa",
  "storyHome1Title": "Ụbọchị gị n'otu nlele",
  "storyHome1Body": "Ihuenyo ụlọ na-egosi ihe dị mkpa taa: ihe na-agwụ n'oge na-adịghị anya na ọnụ ọgụgụ ndekọ ị nwere.",
  "storyHome2Title": "Chọta ihe ọ bụla",
  "storyHome2Body": "Pịa ọchụchọ ka ịchọta ndekọ site na aha, otu ma ọ bụ mmadụ.",
  "storyHome3Title": "Njem na atụmatụ",
  "storyHome3Body": "Njem ị na-eme atụmatụ na atụmatụ ihe omume ndụ na-aga n'ihu na-apụta ebe a, ya na ihe fọdụrụ.",
  "storyHome4Title": "Enyemaka n'otu mmetụ",
  "storyHome4Body": "Bọtịnụ ọkụ na-emepe «Jụọ Vaultara». Foto gị na-emepe profaịlụ, ntọala na nkuzi gị.",
  "storyRenew1Title": "Ncheta bịara",
  "storyRenew1Body": "Tupu ndekọ agwụ, Vaultara na-echetara gị. Pịa ncheta ahụ ka imepe ndekọ ahụ.",
  "storyRenew2Title": "Chekwaa ụbọchị ọhụrụ",
  "storyRenew2Body": "Emegharịala? Pịa «Megharịa» ma tinye ụbọchị njedebe ọhụrụ. Ncheta gị na-esoro ya.",
  "storyRenew3Title": "Ejighị n'aka otu esi eme ya?",
  "storyRenew3Body": "Ọtụtụ ndekọ nwere ntuziaka nwere nzọụkwụ, akwụkwọ na ọnụ ahịa a na-ahụkarị.",
  "storyRenew4Title": "Hapụ ya ka ọ kwughachi",
  "storyRenew4Body": "Maka ndenye aha na ịkwụ ụgwọ kwa afọ, gbanwuo ikwughachi ma ụbọchị ga-aga n'ihu n'onwe ya.",
  "storyAsk1Title": "Jụọ n'okwu nke gị",
  "storyAsk1Body": "Jụọ ihe dịka «Kedu ihe na-agwụ n'afọ a?» ma nweta azịza site na ndekọ gị.",
  "storyAsk2Title": "Kwuo okwu kama ịpị",
  "storyAsk2Body": "Pịa igwe okwu ma kwuo okwu. Okwu gị na-apụta ka ị na-ekwu ma ị nwere ike iziga ozugbo.",
  "storyAsk3Title": "Ị na-akwado mgbanwe ọ bụla",
  "storyAsk3Body": "Rịọ ka itinye ma ọ bụ gbanwee ndekọ, ị ga-ebu ụzọ hụ kaadị. Ọ dịghị ihe a na-echekwa ruo mgbe ị kwadoro.",
  "storyAsk4Title": "Weghachi mgbanwe ọ bụla",
  "storyAsk4Body": "Ị gbanwere obi? Mgbanwe ọ bụla akwadoro nwere ike iweghachi site na otu kaadị ahụ.",
  "storyAsk5Title": "Gaa n'ihu ebe ị kwụsịrị",
  "storyAsk5Body": "A na-edebe mkparịta ụka ụbọchị 90 na «Akụkọ mkparịta ụka», ajụjụ a tụrụ aro na-enyere gị aka ịmalite.",
  "storyWallet1Title": "Kwadebe mbụ",
  "storyWallet1Body": "Mepee kaadị ma ọ bụ akwụkwọ ma họrọ ebe ị na-edebe ya, dịka akpa ego ma ọ bụ akpa gị.",
  "storyWallet2Title": "Chekwaa nọmba mkpọchi",
  "storyWallet2Body": "Tinye nọmba mkpọchi nke ụlọ akụ ọ bụla ugbu a. Ọ dị na kaadị ahụ, nke ị na-agaghị enwe mgbe ị chọrọ ya.",
  "storyWallet3Title": "Ọ bụrụ na ọ furu efu",
  "storyWallet3Body": "Mepee «Furu m akpa ego m» ma pịa «Furu efu» ma ọ bụ «E zuru ya». Vaultara na-edepụta ihe niile dị n'ime ya.",
  "storyWallet4Title": "Gbochie kaadị n'ime nkeji",
  "storyWallet4Body": "Kpọọ ụlọ akụ ọ bụla site na mmetụ otu, kaa kaadị dịka egbochiri ma chekwaa nọmba akụkọ.",
  "storyWallet5Title": "Dochie ma nọrọ na nchekwa",
  "storyWallet5Body": "Dochie akwụkwọ gị, lelee nkwupụta akaụntụ mgbe e chetaara gị ma pịa «Achọtala m ya» ma ọ pụta.",
  "storyLife1Title": "Oge ukwu, otu atụmatụ",
  "storyLife1Body": "Ịkwaga, nwa, ọrụ ọhụrụ ma ọ bụ ihe mberede: họrọ na «Ihe mere n'ọnụ ndụ» ihe na-eme.",
  "storyLife2Title": "Ndekọ gị, ahaziri ahazi",
  "storyLife2Body": "Atụmatụ ahụ na-egosi ndekọ ị ga-emelite, kagbuo ma ọ bụ megharịa, na ndị ị nwere ike ịgbakwunye.",
  "storyLife3Title": "Nzọụkwụ na ụbọchị",
  "storyLife3Body": "Nzọụkwụ na-ekpuchi ihe na-abụghị ndekọ, ụbọchị mmalite na-agwa gị mgbe ị ga-etinye akwụkwọ ka ihe ọ bụla ghara ịbịa n'oge.",
  "storyLife4Title": "Mee ka ọ bụrụ nke gị",
  "storyLife4Body": "Tinye nzọụkwụ nke gị, kekọrịta atụmatụ ahụ dịka PDF ma nweta ncheta gburugburu ụbọchị ahụ.",
  "storyPhotos1Title": "Foto akwụkwọ gị",
  "storyPhotos1Body": "Site na ndekọ ahụ, tinye foto n'ihu na azụ kaadị ma ọ bụ akwụkwọ.",
  "storyPhotos2Title": "Ezoro ezo na ekwentị gị",
  "storyPhotos2Body": "Gbanwuo izo foto ma a na-akpọchi ha na ekwentị gị tupu e bulite ha.",
  "storyPhotos3Title": "Kpọchie ndekọ dị nro",
  "storyPhotos3Body": "Kpọchie ndekọ ma ọ ga-arịọ akara mkpịsị aka ma ọ bụ mkpọchi ihuenyo tupu o meghe.",
  "storyPhotos4Title": "Kpọchie ngwa niile",
  "storyPhotos4Body": "Na ntọala nchekwa, gbanwuo mkpọchi ngwa ma zoo ọdịnaya mgbe ị na-agbanwe ngwa.",
  "storyShare1Title": "Kekọrịta otu ndekọ",
  "storyShare1Body": "Mepee ndekọ ma kekọrịta njikọ na-egosi naanị ndekọ ahụ, ọ dịghị ihe ọzọ.",
  "storyShare2Title": "Ngwugwu ihe akaebe",
  "storyShare2Body": "Tinye ndekọ ị họọrọ, ya na foto ha, n'otu PDF maka onye nwe ụlọ, ụlọ akụ ma ọ bụ ọfịs.",
  "storyShare3Title": "Nọgide na-achịkwa",
  "storyShare3Body": "«Njikọ ekesara» na-egosi njikọ ọ bụla ị mere. Kwụsị nke ọ bụla n'oge ọ bụla ma ọ gaghị emepe ọzọ.",
  "storyHousehold1Title": "Kpọọ ezinụlọ gị",
  "storyHousehold1Body": "Kekọrịta koodu ma ọ bụ njikọ òkù. Onye ọ bụla na-abanye na akaụntụ nke ya.",
  "storyHousehold2Title": "Otu nchịkọta ndekọ",
  "storyHousehold2Body": "Onye ọ bụla na-ahụ otu ndekọ ekekọrịtara ma na-enweta otu ncheta.",
  "storyHousehold3Title": "Onye nwe ya?",
  "storyHousehold3Body": "Ndekọ ọ bụla nwere ike ịbụ nke mmadụ. Aha ya na-apụta na ya na na ncheta ya.",
  "storyImport1Title": "Nyochaa kaadị",
  "storyImport1Body": "See foto kaadị ma ọ bụ akwụkwọ ma Vaultara ejupụta aha na ụbọchị njedebe maka gị.",
  "storyImport2Title": "Bubata ndepụta",
  "storyImport2Body": "Ị nweelarị mpempe akwụkwọ? Bubata ya ma lelee ahịrị ọ bụla tupu e chekwaa ihe ọ bụla.",
  "storyImport3Title": "Kekọrịta na Vaultara",
  "storyImport3Body": "Kekọrịta foto, PDF ma ọ bụ ederede site na ngwa ọzọ na Vaultara ka ịmalite ndekọ ọhụrụ.",
  "storyCosts1Title": "Na kalịnda gị",
  "storyCosts1Body": "Tinye ụbọchị njedebe na kalịnda ekwentị gị, n'akụkụ atụmatụ gị ndị ọzọ.",
  "storyCosts2Title": "Ọnụ ahịa imegharị",
  "storyCosts2Body": "Tinye ọnụ ahịa imegharị na ndekọ ma Vaultara na-egosi ego ị na-emefu kwa afọ.",
  "storyCosts3Title": "Mee atụmatụ n'ihu",
  "storyCosts3Body": "Hụ ọnwa dị oke ọnụ ka ha na-abịa ka imegharị buru ibu ghara iju gị anya.",
  "storyBusiness1Title": "Soro otu gị",
  "storyBusiness1Body": "Tinye ndị ọrụ ma debe asambodo, ikike na akwụkwọ ikike ha n'otu ebe.",
  "storyBusiness2Title": "Ncheta email",
  "storyBusiness2Body": "Ndị ọrụ na-enweta email tupu akwụkwọ ha agwụ, ọbụlagodi na-enweghị ngwa ahụ.",
  "storyBusiness3Title": "Akụkọ kwa ọnwa",
  "storyBusiness3Body": "Ọnwa ọ bụla akụkọ na-egosi ihe dị irè, ihe na-agwụ na ihe na-efu.",
  "storyBusiness4Title": "Rịọ maka mmelite",
  "storyBusiness4Body": "Ziga njikọ ma onye ọrụ ga-ebulite akwụkwọ emegharịrị n'onwe ya.",
