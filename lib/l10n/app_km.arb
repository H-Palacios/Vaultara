  "guideStoreCardsTip": "ប្រើពិន្ទុ ឬប័ណ្ណបញ្ចុះតម្លៃដែលអាចផុតកំណត់ជាមួយកាតចាស់។",
  "guideProfessionalLicencesWhen": "ចាប់ផ្តើម 2 ទៅ 3 ខែមុនផុតកំណត់។",
  "guideProfessionalLicencesStep1": "ពិនិត្យលក្ខខណ្ឌ និងកាលកំណត់បន្តសុពលភាពរបស់ស្ថាប័នវិជ្ជាជីវៈរបស់អ្នក",
  "guideProfessionalLicencesStep2": "ត្រូវប្រាកដថាម៉ោងបណ្តុះបណ្តាល ឬសិក្សាដែលតម្រូវបានបញ្ចប់",
  "guideProfessionalLicencesStep3": "រៀបចំវិញ្ញាបនបត្រ និងភស្តុតាងនៃការអនុវត្តវិជ្ជាជីវៈដែលគេស្នើសុំ",
  "guideProfessionalLicencesStep4": "ដាក់ពាក្យបន្តសុពលភាព ហើយរក្សាការបញ្ជាក់",
  "guideProfessionalLicencesTip": "តាមដានម៉ោងបណ្តុះបណ្តាលពេញមួយឆ្នាំ ដើម្បីកុំឱ្យការបន្តសុពលភាពប្រញាប់ប្រញាល់។",
  "guideWorkAccessCardsWhen": "ចាប់ផ្តើម 2 ទៅ 4 សប្តាហ៍មុនផុតកំណត់។",
  "guideWorkAccessCardsStep1": "សួរក្រុមសន្តិសុខ ឬធនធានមនុស្ស អំពីរបៀបបន្តសុពលភាពកាតចូល",
