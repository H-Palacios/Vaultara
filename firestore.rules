rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A session signed out with "Sign out of all other devices" is turned
    // away at once, not when its short-lived token runs out an hour later.
    // auth_time is when that session signed in, in whole seconds.
    function sessionLive() {
      let me = /databases/$(database)/documents/users/$(request.auth.uid);
      let revoked = exists(me) ? get(me).data.get('sessionsRevokedAt', null) : null;
      return revoked == null
        || request.auth.token.auth_time * 1000 > revoked.toMillis() - 1000;
    }

    function signedIn() {
      return request.auth != null && sessionLive();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isVerifiedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function profileKeys() {
      return ['firstName', 'lastName', 'fullName', 'email', 'createdAt',
              'updatedAt', 'recordsMigrated', 'groupsMigrated', 'companyName',
              'avatarPath', 'avatarVersion', 'monthlySummary', 'monthAhead', 'chatKeepDays',
              'preferredLanguage', 'utcOffsetMinutes', 'nationality',
              'complianceReport', 'residence', 'consent', 'analyticsConsent',
              'extraPassports', 'passportRecords'];
    }

    function consentOk(d) {
      return !('consent' in d)
        || (resource != null && resource.data.get('consent', null) == d.consent)
        || (d.consent is map
            && d.consent.keys().hasOnly(['terms', 'privacy', 'acceptedAt'])
            && d.consent.keys().hasAll(['terms', 'privacy', 'acceptedAt'])
            && d.consent.terms is string && d.consent.terms.size() > 0 && d.consent.terms.size() <= 20
            && d.consent.privacy is string && d.consent.privacy.size() > 0 && d.consent.privacy.size() <= 20
            && d.consent.acceptedAt == request.time);
    }

    function analyticsConsentOk(d) {
      return !('analyticsConsent' in d) || d.analyticsConsent is bool;
    }

    function nationalityOk(d) {
      return !('nationality' in d) || d.nationality == null
        || (d.nationality is string && d.nationality.matches('^[A-Z]{2}$'));
    }

    function extraPassportsOk(d) {
      return !('extraPassports' in d)
        || (d.extraPassports is list && d.extraPassports.size() <= 2
            && (d.extraPassports.size() < 1
                || (d.extraPassports[0] is string
                    && d.extraPassports[0].matches('^[A-Z]{2}$')))
            && (d.extraPassports.size() < 2
                || (d.extraPassports[1] is string
                    && d.extraPassports[1].matches('^[A-Z]{2}$'))));
    }

    function passportRecordsOk(d) {
      return !('passportRecords' in d)
        || (d.passportRecords is map && d.passportRecords.size() <= 3);
    }

    function residenceOk(d) {
      return !('residence' in d) || d.residence == null
        || (d.residence is string && d.residence.matches('^[A-Z]{2}$'));
    }

    function staffEmailOk(d) {
      return (!('email' in d) || d.email == null
          || (d.email is string
              && d.email.size() <= 254
              && d.email.matches('^[^\\s@]{1,64}@[^\\s@]{1,190}[.][^\\s@]{2,63}$')))
        && (!('emailReminders' in d) || d.emailReminders is bool);
    }

    function shortText(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= max);
    }

    function validProfile() {
      return shortText('firstName', 60)
        && shortText('lastName', 60)
        && shortText('fullName', 121)
        && shortText('email', 254)
        && shortText('companyName', 80)
        && avatarPathOk()
        && avatarVersionOk()
        && summaryPrefsOk()
        && nationalityOk(request.resource.data)
        && residenceOk(request.resource.data)
        && extraPassportsOk(request.resource.data)
        && passportRecordsOk(request.resource.data)
        && consentOk(request.resource.data)
        && analyticsConsentOk(request.resource.data);
    }

    function summaryPrefsOk() {
      let d = request.resource.data;
      return (!('monthlySummary' in d) || d.monthlySummary is bool)
        && (!('monthAhead' in d) || d.monthAhead is bool)
        && (!('chatKeepDays' in d) || d.chatKeepDays in [7, 30, 90])
        && (!('complianceReport' in d) || d.complianceReport is bool)
        && (!('preferredLanguage' in d) || d.preferredLanguage == null
            || (d.preferredLanguage is string
                && d.preferredLanguage.matches('^[A-Za-z]{2,3}([_-][A-Za-z0-9]{2,8}){0,3}$')
                && d.preferredLanguage.size() <= 16))
        && (!('utcOffsetMinutes' in d) || d.utcOffsetMinutes == null
            || (d.utcOffsetMinutes is int
                && d.utcOffsetMinutes >= -840
                && d.utcOffsetMinutes <= 840));
    }

    function avatarPathOk() {
      return !('avatarPath' in request.resource.data)
        || request.resource.data.avatarPath == null
        || (request.resource.data.avatarPath is string
            && request.resource.data.avatarPath.size() <= 128
            && request.resource.data.avatarPath
               == 'users/' + request.auth.uid + '/profile/avatar.jpg');
    }

    function avatarVersionOk() {
      return !('avatarVersion' in request.resource.data)
        || request.resource.data.avatarVersion == null
        || (request.resource.data.avatarVersion is int
            && request.resource.data.avatarVersion >= 0
            && request.resource.data.avatarVersion <= 9007199254740991);
    }

    function smallDoc(maxKeys) {
      return request.resource.data.size() <= maxKeys;
    }

    function isPaidUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('plan', 'free')
        in ['premium', 'family', 'business'];
    }

    function staysParked(uid) {
      return resource.data.get('overLimit', false) != true
        || resource.data.get('isDeleted', false) != true
        || (request.resource.data.get('overLimit', false) == true
            && request.resource.data.get('isDeleted', false) == true)
        || isPaidUser(uid);
    }

    function countryOk(list, i) {
      return list.size() <= i
        || (list[i] is string && list[i].matches('^[A-Z]{2}$'));
    }

    function validTrip() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'departure', 'returnDate', 'driving',
                               'needsVisa', 'travellers', 'checklist', 'updatedAt',
                               'countries', 'passportRule', 'needsVisaManual',
                               'visaRecords', 'arrivals', 'flights', 'passportChoice',
                               'purpose', 'places', 'pets'])
        && (!('pets' in d) || (d.pets is list && d.pets.size() <= 10))
        && (!('purpose' in d) || d.purpose in ['holiday', 'family', 'business', 'study', 'work'])
        && (!('driving' in d) || d.driving is bool)
        && (!('needsVisa' in d) || d.needsVisa is bool)
        && (!('needsVisaManual' in d) || d.needsVisaManual is bool)
        && (!('visaRecords' in d) || (d.visaRecords is map && d.visaRecords.size() <= 40))
        && (!('arrivals' in d) || (d.arrivals is map && d.arrivals.size() <= 6))
        && (!('passportChoice' in d) || (d.passportChoice is map && d.passportChoice.size() <= 40))
        && (!('flights' in d) || (d.flights is list && d.flights.size() <= 10))
        && (!('places' in d) || (d.places is list && d.places.size() <= 5))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.departure is timestamp && d.returnDate is timestamp
        && d.travellers is list && d.travellers.size() <= 26
        && d.checklist is list && d.checklist.size() <= 40
        && (!('countries' in d) || (d.countries is list && d.countries.size() <= 5
            && countryOk(d.countries, 0)
            && countryOk(d.countries, 1)
            && countryOk(d.countries, 2)
            && countryOk(d.countries, 3)
            && countryOk(d.countries, 4)))
        && (!('passportRule' in d) || d.passportRule in ['six', 'three', 'stay']);
    }

    function validPet() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'type', 'customType', 'colourIndex', 'birthDate',
                               'microchip', 'chipRegistry', 'vetName', 'vetPhone',
                               'customGroup', 'customEmoji', 'photoVersion'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.type in ['dog', 'cat', 'ferret', 'rabbit', 'guinea_pig', 'hamster', 'rat', 'mouse',
                     'gerbil', 'chinchilla', 'hedgehog', 'horse', 'pony', 'donkey',
                     'parrot', 'budgie', 'cockatiel', 'canary', 'chicken', 'tortoise',
                     'turtle', 'snake', 'lizard', 'gecko', 'bearded_dragon', 'frog',
                     'axolotl', 'fish', 'custom']
        && (!('customType' in d) || (d.type == 'custom' && d.customType is string
            && d.customType.size() > 0 && d.customType.size() <= 30))
        && d.colourIndex is int && d.colourIndex >= 0 && d.colourIndex < 8
        && (!('birthDate' in d) || d.birthDate is timestamp)
        && (!('microchip' in d) || (d.microchip is string && d.microchip.matches('^[0-9]{9,15}$')))
        && (!('chipRegistry' in d) || (d.chipRegistry is string && d.chipRegistry.size() <= 60))
        && (!('vetName' in d) || (d.vetName is string && d.vetName.size() <= 60))
        && (!('vetPhone' in d) || (d.vetPhone is string && d.vetPhone.matches('^[0-9+() -]{3,30}$')))
        && (!('customGroup' in d) || (d.type == 'custom' && d.customGroup in
            ['dog', 'cat', 'ferret', 'rabbit', 'rodent', 'bird', 'reptile', 'amphibian', 'fish', 'horse', 'other']))
        && (!('customEmoji' in d) || (d.type == 'custom' && d.customEmoji is string && d.customEmoji.size() <= 4))
        && (!('photoVersion' in d) || (d.photoVersion is int && d.photoVersion > 0 && d.photoVersion <= 1000000));
    }

    function validRenewalPlan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['expiry', 'country', 'livesIn', 'applyIn', 'applyReason',
                               'checked', 'rating', 'steps',
                               'done', 'bookingUrl', 'fee', 'processing', 'sources',
                               'appointment', 'createdAt', 'updatedAt'])
        && (!('livesIn' in d) || d.livesIn == null
            || (d.livesIn is string && d.livesIn.matches('^[A-Z]{2}$')))
        && (!('applyReason' in d) || d.applyReason == null
            || (d.applyReason is string && d.applyReason.size() <= 80))
        && (!('applyIn' in d) || d.applyIn == null
            || (d.applyIn is string && d.applyIn.matches('^[A-Z]{2}$')))
        && (!('checked' in d) || d.checked == null
            || (d.checked is string && d.checked.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('rating' in d) || (d.rating is int && d.rating >= -1 && d.rating <= 1))
        && d.expiry is string && d.expiry.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('country' in d) || d.country == null
            || (d.country is string && d.country.matches('^[A-Z]{2}$')))
        && d.steps is list && d.steps.size() >= 1 && d.steps.size() <= 12
        && d.done is list && d.done.size() <= 12
        && (!('bookingUrl' in d) || d.bookingUrl == null
            || (d.bookingUrl is string && d.bookingUrl.size() <= 500 && d.bookingUrl.matches('^https://.*')))
        && (!('fee' in d) || d.fee == null || (d.fee is string && d.fee.size() <= 80))
        && (!('processing' in d) || d.processing == null
            || (d.processing is string && d.processing.size() <= 80))
        && (!('sources' in d) || (d.sources is list && d.sources.size() <= 5))
        && (!('appointment' in d) || d.appointment == null
            || (d.appointment is map && d.appointment.size() <= 5))
        && d.updatedAt == request.time;
    }

    // A life plan. summary is what Ask Vaultara reads about the plan,
    // written by the app; calls are when each card's bank was called.
    function validLifePlan() {
      let d = request.resource.data;
      return d.keys().hasOnly(['event', 'date', 'people', 'country', 'createdAt',
                               'finishedAt', 'statuses', 'start', 'skipped', 'updatedAt',
                               'variant', 'tasksDone', 'custom', 'caseNumber',
                               'places', 'foundAt', 'calls', 'summary'])
        && d.event in ['moving', 'homeBuy', 'homeSell', 'nameChange', 'marriage',
                       'divorce', 'baby', 'car', 'job', 'studies', 'retiring',
                       'country', 'childAdult', 'bereavement', 'lostPhone',
                       'jobLoss', 'disaster', 'caringParent', 'lostWallet']
        && (!('variant' in d)
            || d.variant in ['buy', 'sell', 'start', 'leave', 'lost', 'stolen'])
        && (!('tasksDone' in d) || (d.tasksDone is list && d.tasksDone.size() <= 80))
        && (!('caseNumber' in d) || (d.caseNumber is string && d.caseNumber.size() <= 40))
        && (!('places' in d) || (d.places is list && d.places.size() <= 6))
        && (!('foundAt' in d) || d.foundAt == null || d.foundAt is timestamp)
        && (!('calls' in d) || (d.calls is map && d.calls.size() <= 80))
        && (!('summary' in d) || (d.summary is map && d.summary.size() <= 6
            && (!('records' in d.summary) || (d.summary.records is list && d.summary.records.size() <= 80))
            && (!('steps' in d.summary) || (d.summary.steps is list && d.summary.steps.size() <= 60))))
        && (!('custom' in d) || (d.custom is list && d.custom.size() <= 20))
        && (!('date' in d) || d.date == null || d.date is timestamp)
        && d.people is list && d.people.size() > 0 && d.people.size() <= 26
        && (!('country' in d) || (d.country is string && d.country.matches('^[A-Z]{2}$')))
        && d.createdAt is timestamp
        && (!('finishedAt' in d) || d.finishedAt == null || d.finishedAt is timestamp)
        && d.statuses is map && d.statuses.size() <= 80
        && d.start is map && d.start.size() <= 80
        && d.skipped is list && d.skipped.size() <= 40;
    }

    function optionalList(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is list
            && request.resource.data[field].size() <= max);
    }

    // Where a card or document is kept, and the number to call to block it.
    function keptInOk() {
      let d = request.resource.data;
      return (!('keptIn' in d) || d.keptIn == null
              || d.keptIn in ['wallet', 'bag', 'car', 'phoneCase', 'home', 'travelPouch'])
        && shortText('lostLine', 40)
        && (!('issuedIn' in d) || d.issuedIn == null
            || (d.issuedIn is string && d.issuedIn.matches('^[A-Z]{2}$')))
        && shortText('provider', 60)
        && shortText('reference', 40)
        // An encrypted number (base64) and its last four characters.
        && shortText('referenceSealed', 400)
        && shortText('referenceEnd', 4);
    }


    // A staff role and the document groups it needs (Business plan).
    function roleOk(d) {
      return (!('role' in d) || d.role == null
              || (d.role is string && d.role.size() <= 40))
        && (!('requiredGroups' in d) || d.requiredGroups == null
            || (d.requiredGroups is list && d.requiredGroups.size() <= 12));
    }

    function optionalBool(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || request.resource.data[field] is bool;
    }

    function attachmentsOk(uid) {
      let d = request.resource.data;
      let count = d.get('attachments', null) == null ? 0 : d.attachments.size();
      let previous = resource == null ? [] : resource.data.get('attachments', []);
      return !('attachments' in d)
        || d.attachments == null
        || (d.attachments is list
            && (count <= 1
                || (previous is list && count <= previous.size())
                || (count <= 10 && isPaidUser(uid))));
    }

    // The user's own reminder days. Choosing them is Premium; a record that
    // already has them keeps them when it is saved again after a downgrade.
    function reminderStepsOk(uid) {
      let d = request.resource.data;
      let before = resource == null ? null : resource.data.get('reminderSteps', null);
      return !('reminderSteps' in d) || d.reminderSteps == null
        || (d.reminderSteps is list && d.reminderSteps.size() <= 6
            && (d.reminderSteps == before || isPaidUser(uid)));
    }

    function reminderStepsShapeOk() {
      let d = request.resource.data;
      return !('reminderSteps' in d) || d.reminderSteps == null
        || (d.reminderSteps is list && d.reminderSteps.size() <= 6);
    }

    function validRecord(uid) {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && shortText('notes', 4000)
        && shortText('categoryLabel', 120)
        && shortText('subcategoryName', 120)
        && shortText('costCurrency', 8)
        && shortText('holderId', 64)
        && attachmentsOk(uid)
        && optionalList('renewals', 50)
        && (!('repeatMonths' in d) || d.repeatMonths == null
            || (d.repeatMonths is int && d.repeatMonths in [1, 3, 6, 12]))
        && (!('locked' in d) || d.locked is bool)
        && optionalBool('inWallet')
        && keptInOk()
        && reminderStepsOk(uid)
        && (!('leadDays' in d) || d.leadDays == null
            || (d.leadDays is int && d.leadDays >= 0 && d.leadDays <= 365));
    }

    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isHouseholdMember(hid) {
      return signedIn() && request.auth.uid in householdData(hid).get('memberUids', []);
    }

    function canEditHousehold(hid) {
      let h = householdData(hid);
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid in h.get('memberUids', [])
        && h.get('tier', 'free') in ['family', 'business'];
    }

    function householdAttachmentOk(list, i, prefix) {
      return list.size() <= i
        || !(list[i] is map)
        || (list[i].get('storagePath', '') is string
            && list[i].get('storagePath', '').matches('^' + prefix + '[A-Za-z0-9._-]+$'));
    }

    function householdAttachmentsOk(hid, recordId) {
      let d = request.resource.data;
      let prefix = 'households/' + hid + '/records/' + recordId + '/';
      return !('attachments' in d) || d.attachments == null
        || (d.attachments is list && d.attachments.size() <= 10
            && householdAttachmentOk(d.attachments, 0, prefix)
            && householdAttachmentOk(d.attachments, 1, prefix)
            && householdAttachmentOk(d.attachments, 2, prefix)
            && householdAttachmentOk(d.attachments, 3, prefix)
            && householdAttachmentOk(d.attachments, 4, prefix)
            && householdAttachmentOk(d.attachments, 5, prefix)
            && householdAttachmentOk(d.attachments, 6, prefix)
            && householdAttachmentOk(d.attachments, 7, prefix)
            && householdAttachmentOk(d.attachments, 8, prefix)
            && householdAttachmentOk(d.attachments, 9, prefix));
    }

    function householdStampOnCreate() {
      let d = request.resource.data;
      return (!('updatedBy' in d) || d.updatedBy == request.auth.uid)
        && (!('updatedAt' in d) || d.updatedAt == request.time)
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    function householdStampOnUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['updatedBy']) || d.updatedBy == request.auth.uid)
        && (!changed.hasAny(['updatedAt']) || d.updatedAt == request.time)
        && !changed.hasAny(['createdAt']);
    }

    function mayRemoveHouseholdRecord(hid) {
      return request.auth.uid == resource.data.createdBy
        || request.auth.uid == householdData(hid).get('ownerUid', '');
    }

    function householdDeleteFlagOk(hid) {
      let turningOn = request.resource.data.get('isDeleted', false) == true
        && resource.data.get('isDeleted', false) != true;
      return !turningOn || mayRemoveHouseholdRecord(hid);
    }

    function validHouseholdRecord(hid, recordId) {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.createdBy is string
        && d.get('overLimit', false) == false
        && shortText('notes', 4000)
        && shortText('categoryLabel', 120)
        && shortText('subcategoryName', 120)
        && shortText('costCurrency', 8)
        && shortText('holderId', 64)
        && shortText('holderName', 60)
        // Who renews it: empty, or someone who is in the household.
        && (!('assigneeUid' in d) || d.assigneeUid == null
            || (d.assigneeUid is string
                && d.assigneeUid in householdData(hid).get('memberUids', [])))
        && (!('holderColour' in d) || d.holderColour == null
            || (d.holderColour is int && d.holderColour >= 0 && d.holderColour <= 31))
        && householdAttachmentsOk(hid, recordId)
        && optionalList('renewals', 50)
        && (!('repeatMonths' in d) || d.repeatMonths == null
            || (d.repeatMonths is int && d.repeatMonths in [1, 3, 6, 12]))
        && (!('locked' in d) || d.locked is bool)
        && optionalBool('inWallet')
        && keptInOk()
        && optionalBool('isDeleted')
        && reminderStepsShapeOk()
        && (!('leadDays' in d) || d.leadDays == null
            || (d.leadDays is int && d.leadDays >= 0 && d.leadDays <= 365));
    }

    function validPhotoKey(keyId) {
      let d = request.resource.data;
      return keyId == 'photos'
        && d.keys().hasOnly(['version', 'alg', 'kdf', 'iterations', 'salt', 'wrappedKey', 'createdAt'])
        && d.keys().hasAll(['version', 'alg', 'kdf', 'iterations', 'salt', 'wrappedKey'])
        && d.version is int && d.version >= 1 && d.version <= 10
        && d.alg is string && d.alg.size() <= 40
        && d.kdf is string && d.kdf.size() <= 40
        && d.iterations is int && d.iterations >= 100000 && d.iterations <= 5000000
        && d.salt is string && d.salt.size() >= 12 && d.salt.size() <= 64
        && d.wrappedKey is string && d.wrappedKey.size() >= 40 && d.wrappedKey.size() <= 200
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    function validPushDevice(deviceId) {
      let d = request.resource.data;
      return deviceId.matches('^[A-Za-z0-9]{16,64}$')
        && d.keys().hasOnly(['token', 'platform', 'locale', 'updatedAt'])
        && d.keys().hasAll(['token', 'platform', 'locale', 'updatedAt'])
        && d.token is string && d.token.size() > 0 && d.token.size() <= 1024
        && d.platform in ['android', 'ios']
        && d.locale is string && d.locale.size() <= 16
        && d.locale.matches('^[A-Za-z]{2,3}([_-][A-Za-z0-9]{2,8}){0,3}$')
        && d.updatedAt == request.time;
    }

    function sessionDeviceKeys() {
      return ['label', 'platform', 'model', 'osVersion', 'appVersion', 'createdAt', 'lastSeenAt'];
    }

    function isSessionDeviceId(deviceId) {
      return deviceId.matches('^[0-9a-f]{32}$');
    }

    function validSessionDevice() {
      let d = request.resource.data;
      return d.keys().hasOnly(sessionDeviceKeys().concat(['signedOutAt']))
        && d.keys().hasAll(sessionDeviceKeys())
        && d.label is string && d.label.size() <= 60
        && d.platform in ['android', 'ios']
        && d.model is string && d.model.size() <= 60
        && d.osVersion is string && d.osVersion.size() <= 30
        && d.appVersion is string && d.appVersion.size() <= 20
        && d.createdAt is timestamp
        && d.lastSeenAt is timestamp;
    }

    function groupKeys() {
      return ['categoryKey', 'groups', 'deletedGroups', 'ids', 'updatedAt'];
    }

    function validGroup() {
      let d = request.resource.data;
      // ids pairs each group name with the key its records carry, so a
      // group can be renamed and names in any script get their own key.
      return (!('categoryKey' in d) || (d.categoryKey is string && d.categoryKey.size() <= 120))
        && (!('groups' in d) || (d.groups is list && d.groups.size() <= 200))
        && (!('deletedGroups' in d) || (d.deletedGroups is list && d.deletedGroups.size() <= 200))
        && (!('ids' in d) || (d.ids is list && d.ids.size() <= 400));
    }

    function validPreference() {
      // done and hints hold tutorial ids, for preferences/tutorials. pins
      // holds pinned category keys, for preferences/pinnedCategories.
      // snoozed holds insights put off with Later, for preferences/insights.
      // afterExpiry, weekly, household, updates and sharedOnlyMine are on/off
      // choices, for preferences/notifications; the push functions read
      // household, updates and sharedOnlyMine before sending. reminderSound and urgentSound are the sound
      // keys picked for reminders.
      return smallDoc(20)
        && optionalList('labels', 100)
        && optionalList('pins', 100)
        && optionalList('done', 60)
        && optionalList('hints', 60)
        && optionalList('snoozed', 60)
        && optionalBool('afterExpiry')
        && optionalBool('weekly')
        && optionalBool('household')
        && optionalBool('updates')
        && optionalBool('sharedOnlyMine')
        && optionalSoundKey('reminderSound')
        && optionalSoundKey('urgentSound');
    }

    function optionalSoundKey(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].matches('^[a-z_]{1,24}$'));
    }

    // Chats are kept for a week, a month or three months, as the user
    // chooses (chatKeepDays), and then deleted by the expireAt policy.
    function assistantExpiryOk(d) {
      return d.expireAt is timestamp
        && d.expireAt > request.time + duration.value(6, 'd')
        && d.expireAt < request.time + duration.value(92, 'd');
    }

    function validAssistantChat() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'createdAt', 'updatedAt', 'expireAt'])
        && d.keys().hasAll(['title', 'createdAt', 'updatedAt', 'expireAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.createdAt is timestamp
        && d.updatedAt == request.time
        && assistantExpiryOk(d);
    }

    function assistantProposalOk(list, i) {
      return list.size() <= i
        || (list[i] is map
            && list[i].keys().hasOnly(['type', 'summary', 'status', 'action', 'at', 'stamp'])
            && list[i].keys().hasAll(['type', 'summary', 'status'])
            && list[i].get('type', null) is string
            && list[i].get('type', '').size() <= 24
            && list[i].get('summary', null) is string
            && list[i].get('summary', '').size() <= 200
            && list[i].get('status', '') in ['pending', 'applied', 'opened', 'cancelled']
            && (!('action' in list[i]) || (list[i].action is map
                && list[i].get('status', '') == 'pending'
                && list[i].action.size() <= 60))
            && (!('at' in list[i]) || list[i].at is int)
            && (!('stamp' in list[i]) || (list[i].stamp is string && list[i].stamp.size() <= 40)));
    }

    function assistantProposalsOk(d) {
      return !('proposals' in d)
        || (d.proposals is list && d.proposals.size() <= 20
            && assistantProposalOk(d.proposals, 0)
            && assistantProposalOk(d.proposals, 1)
            && assistantProposalOk(d.proposals, 2)
            && assistantProposalOk(d.proposals, 3)
            && assistantProposalOk(d.proposals, 4)
            && assistantProposalOk(d.proposals, 5)
            && assistantProposalOk(d.proposals, 6)
            && assistantProposalOk(d.proposals, 7)
            && assistantProposalOk(d.proposals, 8)
            && assistantProposalOk(d.proposals, 9)
            && assistantProposalOk(d.proposals, 10)
            && assistantProposalOk(d.proposals, 11)
            && assistantProposalOk(d.proposals, 12)
            && assistantProposalOk(d.proposals, 13)
            && assistantProposalOk(d.proposals, 14)
            && assistantProposalOk(d.proposals, 15)
            && assistantProposalOk(d.proposals, 16)
            && assistantProposalOk(d.proposals, 17)
            && assistantProposalOk(d.proposals, 18)
            && assistantProposalOk(d.proposals, 19));
    }

    function validAssistantFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly(['rating', 'question', 'answer', 'chatId', 'createdAt', 'expireAt'])
        && d.keys().hasAll(['rating', 'question', 'answer', 'createdAt', 'expireAt'])
        && d.rating in [1, -1]
        && d.question is string && d.question.size() <= 2000
        && d.answer is string && d.answer.size() <= 4000
        && (!('chatId' in d) || (d.chatId is string && d.chatId.size() <= 40))
        && d.createdAt == request.time
        && assistantExpiryOk(d);
    }

    function validAssistantReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['reason', 'question', 'answer', 'chatId', 'createdAt', 'expireAt'])
        && d.keys().hasAll(['reason', 'question', 'answer', 'createdAt', 'expireAt'])
        && d.reason in ['harmful', 'wrong', 'other']
        && d.question is string && d.question.size() <= 2000
        && d.answer is string && d.answer.size() <= 4000
        && (!('chatId' in d) || (d.chatId is string && d.chatId.size() <= 40))
        && d.createdAt == request.time
        && assistantExpiryOk(d);
    }

    function validAssistantMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['role', 'text', 'createdAt', 'expireAt', 'proposals'])
        && d.keys().hasAll(['role', 'text', 'createdAt', 'expireAt'])
        && d.role in ['user', 'assistant']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 8000
        && d.createdAt == request.time
        && assistantExpiryOk(d)
        && (d.role == 'assistant' || !('proposals' in d))
        && assistantProposalsOk(d);
    }

    function legacyFreeFields() {
      return request.resource.data.get('plan', 'free') == 'free'
        && request.resource.data.get('isPremium', false) == false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileKeys().concat(['plan', 'isPremium']))
        && legacyFreeFields()
        && validProfile();

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileKeys())
        && validProfile();

      allow delete: if false;

      match /records/{recordId} {
        allow read: if isOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && smallDoc(60)
          && request.resource.data.get('overLimit', false) == false
          && request.resource.data.get('movedFromHousehold', false) == false
          && validRecord(uid);
        allow update: if isVerifiedOwner(uid) && smallDoc(60) && staysParked(uid)
          && validRecord(uid);
        allow delete: if isVerifiedOwner(uid);
      }

      match /categories/{categoryKey} {
        allow read: if isOwner(uid);
        allow create: if isVerifiedOwner(uid)
          && smallDoc(30)
          && request.resource.data.get('isDeleted', false) == false
          && request.resource.data.get('overLimit', false) == false;
        allow update: if isVerifiedOwner(uid) && smallDoc(30) && staysParked(uid);
        allow delete: if isVerifiedOwner(uid);
      }

      match /groups/{categoryKey} {
        allow read: if isOwner(uid);
        allow create: if isVerifiedOwner(uid) && smallDoc(30)
          && request.resource.data.keys().hasOnly(groupKeys())
          && validGroup();
        allow update: if isVerifiedOwner(uid) && smallDoc(30)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(groupKeys())
          && validGroup();
        allow delete: if isVerifiedOwner(uid);
      }

      match /preferences/{prefId} {
        allow read: if isOwner(uid);
        allow create, update: if isVerifiedOwner(uid) && validPreference();
        allow delete: if isVerifiedOwner(uid);
      }

      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow create: if (isSessionDeviceId(deviceId)
            && isOwner(uid)
            && validSessionDevice()
            && !('signedOutAt' in request.resource.data))
          || (!isSessionDeviceId(deviceId) && isVerifiedOwner(uid) && validPushDevice(deviceId));
        allow update: if (isSessionDeviceId(deviceId)
            && isOwner(uid)
            && validSessionDevice()
            && request.resource.data.get('signedOutAt', null) == resource.data.get('signedOutAt', null))
          || (!isSessionDeviceId(deviceId) && isVerifiedOwner(uid) && validPushDevice(deviceId));
        allow delete: if isOwner(uid);
      }

      match /securityEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /billing/{billingId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /people/{personId} {
        allow read: if isOwner(uid);
        allow delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid)
          && (request.method == 'update' || isPaidUser(uid))
          && request.resource.data.keys().hasOnly(['name', 'colourIndex', 'nationality',
                                                   'email', 'emailReminders', 'residence',
                                                   'extraPassports', 'passportRecords',
                                                   'role', 'requiredGroups'])
          && roleOk(request.resource.data)
          && nationalityOk(request.resource.data)
          && residenceOk(request.resource.data)
          && extraPassportsOk(request.resource.data)
          && passportRecordsOk(request.resource.data)
          && staffEmailOk(request.resource.data)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.colourIndex is int
          && request.resource.data.colourIndex >= 0
          && request.resource.data.colourIndex < 8;
      }

      // Pets are kept apart from people, so they never use a member place.
      // Paid plans add them; a function removes any past the app's limit.
      match /pets/{petId} {
        allow read: if isOwner(uid);
        allow delete: if isVerifiedOwner(uid);
        allow create, update: if isVerifiedOwner(uid)
          && isPaidUser(uid)
          && validPet();
      }

      match /trips/{tripId} {
        allow read: if isOwner(uid);
        allow delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && isPaidUser(uid) && validTrip();
        allow update: if isVerifiedOwner(uid) && isPaidUser(uid) && validTrip();
      }

      match /lifePlans/{planId} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && smallDoc(18) && validLifePlan();
      }

      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /subcategories/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      match /keys/{keyId} {
        allow read: if isOwner(uid);
        allow delete: if isVerifiedOwner(uid);
        allow create: if isVerifiedOwner(uid) && validPhotoKey(keyId);
        allow update: if false;
      }

      // Live progress of one Ask Vaultara answer. Written only by the
      // askVaultara function; the user may only ask it to stop.
      match /assistantRuns/{runId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled'])
          && request.resource.data.cancelled == true;
        allow create, delete: if false;
      }

      // Words Ask Vaultara learned for this user's records. Written and
      // cleared only by the Cloud Functions.
      match /assistantMemory/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // A renewal plan from Ask Vaultara's renewal coach, one per record,
      // saved by the app after the user confirms the card.
      match /renewalPlans/{recordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && smallDoc(16) && validRenewalPlan();
      }

      // Thumbs up or down on an answer, so weak answers can be found.
      match /assistantFeedback/{messageId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAssistantFeedback();
        allow delete: if isOwner(uid);
      }

      match /assistantReports/{messageId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validAssistantReport();
        allow delete: if isOwner(uid);
      }

      match /assistantChats/{chatId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validAssistantChat()
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'expireAt'])
          && validAssistantChat();
        allow delete: if isOwner(uid);

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/assistantChats/$(chatId))
            && validAssistantMessage();
          allow update: if isOwner(uid)
            && resource.data.role == 'assistant'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposals'])
            && assistantProposalsOk(request.resource.data);
          allow delete: if isOwner(uid);
        }
      }

      match /{other=**} {
        allow read, write: if false;
      }
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.get('memberUids', []);
      allow write: if false;

      match /records/{recordId} {
        allow read: if isHouseholdMember(hid);
        allow create: if canEditHousehold(hid)
          && smallDoc(60)
          && validHouseholdRecord(hid, recordId)
          && householdStampOnCreate()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canEditHousehold(hid)
          && smallDoc(60)
          && validHouseholdRecord(hid, recordId)
          && householdStampOnUpdate()
          && householdDeleteFlagOk(hid)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if canEditHousehold(hid)
          && mayRemoveHouseholdRecord(hid);
      }

      // Business change history: written only by the server, read only by
      // the household's owner while the household is on the Business plan.
      match /history/{entryId} {
        allow read: if signedIn()
          && request.auth.uid == householdData(hid).get('ownerUid', '')
          && householdData(hid).get('tier', 'free') == 'business';
        allow write: if false;
      }

      match /{other=**} {
        allow read, write: if false;
      }
    }

    match /invites/{code} {
      allow read, write: if false;
    }

    match /updateRequests/{requestId} {
      allow read, write: if false;
    }

    match /staffEmailLog/{logId} {
      allow read, write: if false;
    }

    match /securityState/{uid} {
      allow read, write: if false;
    }

    match /securityAlerts/{alertId} {
      allow read, write: if false;
    }

    match /deletionTokens/{nonce} {
      allow read, write: if false;
    }

    match /deletionRequests/{requestId} {
      allow read, write: if false;
    }

    // Hashes of two-step backup codes. Only the Cloud Functions use them.
    match /mfaBackupCodes/{uid} {
      allow read, write: if false;
    }

    // Pending sign-up codes and email cooldowns. Only the Cloud Functions use them.
    match /pendingSignUps/{id} {
      allow read, write: if false;
    }
    match /signUpNotices/{id} {
      allow read, write: if false;
    }

    match /billingNotices/{noticeId} {
      allow read, write: if false;
    }

    match /visaData/{passport} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /fx/{docId} {
      allow read: if signedIn() && docId == 'latest';
      allow write: if false;
    }

    match /visaLinks/{docId} {
      allow read: if signedIn() && docId == 'all';
      allow write: if false;
    }

    // Official rules read from government pages. Anyone signed in may read
    // a country; only the server writes, after its own checks and review.
    match /officialRules/{country} {
      allow read: if signedIn() && country.matches('^[A-Z]{2}$');
      allow write: if false;
    }

    // Where the rules come from, each reading and its review: server only.
    match /ruleSources/{docId} {
      allow read, write: if false;
    }
    match /ruleReviews/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
